@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam SwimlaneTitleFontStyle bold
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #2F5597
skinparam SequenceLifeLineBorderColor #888888
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #2F5597
skinparam ActorBorderColor #2F5597
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceGroupHeaderFontStyle bold
title UC-L06: Manage Tests - Sequence
skinparam defaultFontSize 15
skinparam ParticipantFontSize 15
skinparam ActorFontSize 15
skinparam DatabaseFontSize 15
hide footbox
actor "Lab Technician" as U
participant ":LabTestsView" as V
participant ":LabTestController" as C
participant ":LabTestService" as S
database "HCMS Database" as DB
U -> V : add / edit test
V -> C : Save(LabTestDto)
C -> C : validate model (min < max, price >= 0)
alt valid
  C -> S : SaveAsync(dto)
  S -> DB : check name unique
  alt unique
    S -> DB : INSERT / UPDATE LabTest
    C --> V : catalog updated
  else duplicate
    C --> V : "test already exists"
  end
else invalid
  C --> V : validation errors
end
U -> V : delete test
V -> C : Delete(id)
C -> S : DeleteAsync(id)
S -> DB : used in requests?
alt used
  S -> DB : UPDATE IsActive = false
else not used
  S -> DB : DELETE LabTest
end
@enduml
