@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam SwimlaneTitleFontStyle bold
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #2F5597
skinparam SequenceLifeLineBorderColor #888888
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #2F5597
skinparam ActorBorderColor #2F5597
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceGroupHeaderFontStyle bold
title UC-R02: Manage Imaging Session Appointments - Sequence
skinparam defaultFontSize 15
skinparam ParticipantFontSize 15
skinparam ActorFontSize 15
skinparam DatabaseFontSize 15
hide footbox
actor Radiologist as U
actor Patient as P
participant ":ScheduleView" as V
participant ":ImagingScheduleController" as C
participant ":SchedulingService" as S
database "HCMS Database" as DB
participant ":NotificationHub" as H
U -> V : select request, device, time
V -> C : Book(requestId, deviceId, start)
C -> S : BookAsync(requestId, deviceId, start)
S -> DB : find overlaps (device, room, patient)
alt no conflict
  S -> DB : INSERT ImagingSession, status = Scheduled
  S ->> H : NotifyPatient(sessionId)
  H ->> P : appointment confirmed
  C --> V : session confirmed
else conflict
  S -> DB : find nearest free slot
  S --> C : ConflictResult(suggestedSlot)
  C --> V : refused + suggestion
end
@enduml
