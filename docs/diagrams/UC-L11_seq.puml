@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam SwimlaneTitleFontStyle bold
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #2F5597
skinparam SequenceLifeLineBorderColor #888888
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #2F5597
skinparam ActorBorderColor #2F5597
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceGroupHeaderFontStyle bold
title UC-L11: Generate Daily Lab Activity Report - Sequence
skinparam defaultFontSize 15
skinparam ParticipantFontSize 15
skinparam ActorFontSize 15
skinparam DatabaseFontSize 15
hide footbox
actor "Lab Technician" as U
participant ":LabReportController" as C
participant ":LabReportService" as S
database "HCMS Database" as DB
U -> C : ActivityReport(from, to)   (default: today)
C -> S : BuildPageAsync(from, to)
S -> DB : SELECT requests with RequestedAt in the period (+ tests)
S -> S : count by current status and by test;\nmedian of (ResultIssuedAt - ReceivedAt)
alt activity
  C --> U : report summary
else none
  C --> U : empty report + "No activity"
end
opt print / PDF
  U -> C : ActivityReportPrint(from, to)
  C -> S : BuildPageAsync(from, to)
  C --> U : print-friendly page (same summary)
  U -> U : browser "Print / Save as PDF"
end
note over C : No PDF library: the browser's "Save as PDF"\nturns the printable page into a PDF file.
@enduml
