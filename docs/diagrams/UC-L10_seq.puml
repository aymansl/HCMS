@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam SwimlaneTitleFontStyle bold
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #2F5597
skinparam SequenceLifeLineBorderColor #888888
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #2F5597
skinparam ActorBorderColor #2F5597
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceGroupHeaderFontStyle bold
title UC-L10: Send Alert When Result Is Issued - Sequence
skinparam defaultFontSize 15
skinparam ParticipantFontSize 15
skinparam ActorFontSize 15
skinparam DatabaseFontSize 15
hide footbox
actor "Lab Technician" as U
actor Doctor as D
participant ":LabResultController" as C
participant ":DoctorLabResultsController" as DC
participant ":LabResultService" as S
participant ":INotificationService" as N
database "HCMS Database" as DB
U -> C : EnterResults(id, values, issue = false)
C -> S : SaveAsync(id, userId, values, issue: false)
S -> S : compare with reference ranges and critical limits
S -> DB : UPSERT LabResult; Received -> InProgress (first save)
U -> C : EnterResults(id, values, issue = true)
C -> S : SaveAsync(id, userId, values, issue: true)
S -> DB : get request status
alt status Received / InProgress and every test has a value
  S -> DB : UPDATE status = ResultIssued, ResultIssuedAt, HasCriticalResult
  alt critical value
    S -> N : CreateForUserAsync(doctor, "CRITICAL lab result")
  else
    S -> N : CreateForUserAsync(doctor, "Lab result issued")
  end
  S -> N : CreateForUserAsync(patient, "Your lab result is ready")
  C --> U : result issued
else cancelled, issued already, or a value missing
  C --> U : error (nothing saved)
end
opt critical value
  D -> DC : AcknowledgeCriticalResult(id)
  DC -> S : AcknowledgeCriticalAsync(doctorId, id)
  S -> DB : UPDATE CriticalAcknowledgedAt, CriticalAcknowledgedBy
end
note over N : Notifications are shown on refresh;\nSignalR comes with S3 (Increment 6).
@enduml
