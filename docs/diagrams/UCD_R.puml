  usecase "Manage Imaging Session Appointments\n(UC-R02)" as UC_R02
  usecase "Write and Send Imaging Report\n(UC-R03)" as UC_R03
  usecase "Manage Request and Imaging Types\n(UC-R04)" as UC_R04
  usecase "Add Radiologist Note\n(UC-R05)" as UC_R05
  usecase "Generate Daily Radiology Report\n(UC-R06)" as UC_R06
}
A -- UC_R01
A -- UC_R02
A -- UC_R03
A -- UC_R04
A -- UC_R05
A -- UC_R06
UC_R01 -- Doctor
UC_R03 -- Doctor
UC_R02 -- Patient
UC_R03 -- Patient
