@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam SwimlaneTitleFontStyle bold
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #2F5597
skinparam SequenceLifeLineBorderColor #888888
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #2F5597
skinparam ActorBorderColor #2F5597
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceGroupHeaderFontStyle bold
title UC-L03: Receive Lab Test Request from Doctor - Sequence
skinparam defaultFontSize 15
skinparam ParticipantFontSize 15
skinparam ActorFontSize 15
skinparam DatabaseFontSize 15
hide footbox
actor Doctor as D
actor "Lab Technician" as U
participant ":PatientRecordView" as DV
participant ":DoctorLabRequestsController" as DC
participant ":LabRequestController" as C
participant ":LabRequestService" as S
participant ":IMedicalRecordService" as MR
participant ":INotificationService" as N
database "HCMS Database" as DB
D -> DV : Request Lab Test
DV -> DC : CreateLabRequest(model)
DC -> DC : validate model (at least one test)
DC -> S : CreateAsync(doctorId, model)
S -> DB : find patient
alt patient exists
  S -> MR : DoctorHasAccessAsync(doctorId, patientId)
  S -> DB : active selected tests
  S -> DB : INSERT LabRequest (Requested) + items (price snapshot)
  S -> N : CreateForRoleAsync(LabTechnician, "New lab request")
  DC --> DV : request sent
else patient not found
  S -> N : CreateForUserAsync(doctor, "Lab request rejected")
  DC --> DV : request rejected (patient not found)
end
U -> C : RequestDetails(id)
C -> S : GetDetailsAsync(id)
alt request complete
  U -> C : ReceiveRequest(id)
  C -> S : ReceiveAsync(id, userId)
  S -> DB : UPDATE status = Received, ReceivedAt, ReceivedBy
  C --> U : status Received
else incomplete
  U -> C : ReturnRequest(id, note)
  C -> S : ReturnToDoctorAsync(id, userId, note)
  S -> DB : UPDATE status = ReturnedToDoctor, ReturnNote
  S -> N : CreateForUserAsync(doctor, note)
  D -> DC : EditLabRequest(id, model)
  DC -> S : ResubmitAsync(doctorId, model)
  S -> DB : UPDATE status = Requested, items
  S -> N : CreateForRoleAsync(LabTechnician, "Lab request resent")
end
note over N : Notifications are shown on refresh;\nSignalR comes with S3 (Increment 6).
@enduml
