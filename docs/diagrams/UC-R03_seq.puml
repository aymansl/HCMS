@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam SwimlaneTitleFontStyle bold
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #2F5597
skinparam SequenceLifeLineBorderColor #888888
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #2F5597
skinparam ActorBorderColor #2F5597
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceGroupHeaderFontStyle bold
title UC-R03: Write and Send Imaging Report - Sequence
skinparam defaultFontSize 15
skinparam ParticipantFontSize 15
skinparam ActorFontSize 15
skinparam DatabaseFontSize 15
hide footbox
actor Radiologist as U
participant ":ReportEditorView" as V
participant ":ImagingReportController" as C
participant ":ImagingReportService" as S
database "HCMS Database" as DB
participant ":NotificationHub" as H
U -> V : write report
V -> C : SaveDraft(sessionId, dto)
C -> S : SaveDraftAsync(sessionId, dto)
S -> DB : check session status = Performed
S -> DB : UPSERT ImagingReport (Draft)
U -> V : approve
V -> C : Approve(reportId)
C -> S : ApproveAsync(reportId)
alt impression not empty
  S -> DB : UPDATE status = Sent
  par
    S ->> H : NotifyDoctor(requestId)
  else
    S ->> H : NotifyPatient(requestId)
  end
  C --> V : report sent
else missing impression
  C --> V : error
end
@enduml
