@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam SwimlaneTitleFontStyle bold
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #2F5597
skinparam SequenceLifeLineBorderColor #888888
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #2F5597
skinparam ActorBorderColor #2F5597
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceGroupHeaderFontStyle bold
title UC-L09: View Patient's Test History - Sequence
skinparam defaultFontSize 15
skinparam ParticipantFontSize 15
skinparam ActorFontSize 15
skinparam DatabaseFontSize 15
hide footbox
actor "Lab Technician" as U
participant ":LabHistoryController" as C
participant ":LabHistoryService" as S
participant ":IPatientService" as P
database "HCMS Database" as DB
U -> C : PatientHistory(term)
C -> S : BuildPageAsync(term)
S -> P : SearchAsync(term)
P -> DB : SELECT patients (name, email, phone)
alt found
  U -> C : PatientHistory(patientId)
  C -> S : BuildPageAsync(patientId)
  S -> DB : SELECT ResultIssued requests + results, newest first
  C --> U : history (abnormal and critical values marked)
  opt one test over time
    U -> C : PatientHistory(patientId, testId)
    S -> DB : SELECT values of the test, oldest first
    C --> U : table + line chart with the reference range
  end
else not found
  C --> U : "Patient not found."
end
@enduml
