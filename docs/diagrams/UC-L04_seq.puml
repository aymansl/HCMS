@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam SwimlaneTitleFontStyle bold
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #2F5597
skinparam SequenceLifeLineBorderColor #888888
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #2F5597
skinparam ActorBorderColor #2F5597
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceGroupHeaderFontStyle bold
title UC-L04: Receive Test Request Cancellation - Sequence
skinparam defaultFontSize 15
skinparam ParticipantFontSize 15
skinparam ActorFontSize 15
skinparam DatabaseFontSize 15
hide footbox
actor Doctor as D
actor "Lab Technician" as U
participant ":DoctorLabRequestsController" as DC
participant ":LabRequestController" as C
participant ":LabRequestService" as S
participant ":INotificationService" as N
database "HCMS Database" as DB
D -> DC : CancelLabRequest(id, reason)
DC -> S : CancelAsync(doctorId, id, reason)
S -> DB : get the doctor's request
alt status before ResultIssued
  S -> DB : UPDATE status = Cancelled, CancelledAt, CancelReason
  S -> N : CreateForRoleAsync(LabTechnician, "Lab request cancelled")
  DC --> D : cancelled
else result issued
  S --> DC : "result already issued"
  DC --> D : cancellation refused
end
U -> C : RequestDetails(id)
C --> U : "Cancelled by the doctor" (time, reason)
opt sample already taken
  U -> C : AddCancellationNote(id, note)
  C -> S : AddCancellationNoteAsync(id, userId, note)
  S -> DB : UPDATE CancellationNote, CancellationNoteAt, CancellationNoteBy
end
note over N : Notifications are shown on refresh;\nSignalR comes with S3 (Increment 6).
@enduml
