@startuml
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBackgroundColor #EEF4FB
skinparam ActivityBorderColor #2F5597
skinparam ActivityDiamondBackgroundColor #FFF7E0
skinparam SwimlaneTitleFontStyle bold
skinparam ParticipantBackgroundColor #EEF4FB
skinparam ParticipantBorderColor #2F5597
skinparam SequenceLifeLineBorderColor #888888
skinparam UsecaseBackgroundColor #EEF4FB
skinparam UsecaseBorderColor #2F5597
skinparam ActorBorderColor #2F5597
skinparam DatabaseBackgroundColor #EEF4FB
skinparam SequenceGroupHeaderFontStyle bold
title UC-L05: Receive Appointment Booking from Patient - Sequence
skinparam defaultFontSize 15
skinparam ParticipantFontSize 15
skinparam ActorFontSize 15
skinparam DatabaseFontSize 15
hide footbox
actor Patient as P
actor "Lab Technician" as U
participant ":PatientLabAppointmentsController" as C
participant ":LabScheduleController" as LC
participant ":LabAppointmentService" as S
participant ":INotificationService" as N
database "HCMS Database" as DB
P -> C : BookLabAppointment(requestId, date)
C -> S : GetBookingFormAsync(userId, requestId, date)
S -> DB : the patient's request + booked slots of the day
S --> C : bookable days (Sat-Thu, 14 days), free slots (08:00-13:45, 15 min)
P -> C : BookLabAppointment(requestId, slot)
C -> S : BookAsync(userId, requestId, slot)
S -> DB : request waiting for its sample? slot valid and free?
alt free
  alt no booking yet
    S -> DB : INSERT LabAppointment (Booked)
  else change (alternative flow)
    S -> DB : UPDATE SlotStart
  end
  note right of DB : unique index on SlotStart\nfor Booked rows
  S -> N : CreateForRoleAsync(LabTechnician, booking)
  S -> N : CreateForUserAsync(patient, confirmation)
  C --> P : booking confirmed
else taken (or refused by the unique index)
  C --> P : "slot just booked, choose another time"
end
U -> LC : Schedule(date)
LC -> S : GetScheduleAsync(date)
LC --> U : bookings by time
note over N : Notifications are shown on refresh;\nSignalR comes with S3 (Increment 6).
@enduml
