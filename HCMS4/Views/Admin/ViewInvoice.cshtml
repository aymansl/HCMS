@model HCMS4.Models.Invoice

@{
    ViewData["Title"] = "View Invoice";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3">Invoice Details</h1>
                <div>
                    <a asp-action="Patients" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left me-1"></i> Back to Patients
                    </a>
                    <button onclick="window.print()" class="btn btn-gradient-info">
                        <i class="bi bi-printer me-1"></i> Print
                    </button>
                </div>
            </div>

            <div class="card" id="invoiceCard">
                <div class="card-body p-4">
                    <div class="row mb-4 border-bottom pb-4">
                        <div class="col-md-6">
                            <h1 class="text-primary">
                                <i class="bi bi-receipt"></i> INVOICE
                            </h1>
                            <div class="mt-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge @(Model.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-danger") badge-lg">
                                        @Model.PaymentStatus.ToString().ToUpper()
                                    </span>
                                    <span class="ms-2 text-muted">Invoice #@Model.Id</span>
                                </div>
                                <div>
                                    <strong>Date:</strong> @Model.InvoiceDate.ToString("yyyy-MM-dd")
                                    @if (Model.PaymentDate.HasValue)
                                    {
                                        <span class="ms-3">
                                            <strong>Paid:</strong> @Model.PaymentDate.Value.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <h5 class="mb-3">Healthcare Management System</h5>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">BILL TO:</h6>
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5>@Model.Patient?.User?.FullName</h5>
                                    <div class="text-muted">
                                        Patient ID: @Model.PatientId<br />
                                        @if (!string.IsNullOrEmpty(Model.Patient?.Address))
                                        {
                                            @Model.Patient.Address<br />
                                        }
                                        @Model.Patient?.User?.Email<br />
                                        @Model.Patient?.User?.PhoneNumber
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            @if (Model.Appointment != null || Model.Prescription != null)
                            {
                                <h6 class="text-muted mb-2">SERVICE DETAILS:</h6>
                                <div class="card bg-light">
                                    <div class="card-body">
                                        @if (Model.Appointment != null)
                                        {
                                            <div class="mb-2">
                                                <i class="bi bi-calendar-check text-primary me-1"></i>
                                                <strong>Appointment:</strong> @Model.Appointment.AppointmentDateTime.ToString("yyyy-MM-dd hh:mm tt")<br />
                                                <small class="text-muted">With Dr. @Model.Appointment.Doctor?.User?.FullName</small>
                                            </div>
                                        }
                                        @if (Model.Prescription != null)
                                        {
                                            <div>
                                                <i class="bi bi-prescription text-success me-1"></i>
                                                <strong>Prescription:</strong> #@Model.Prescription.Id<br />
                                                <small class="text-muted">Prescribed by Dr. @Model.Prescription.Doctor?.User?.FullName</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                  
                    <div class="row mb-4">
                        <div class="col-12">
                            <h6 class="text-muted mb-3">INVOICE SUMMARY</h6>
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Description</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <strong>Consultation Fee</strong><br />
                                                <small class="text-muted">Professional medical consultation</small>
                                            </td>
                                            <td class="text-end">$@Model.ConsultationFee.ToString("F2")</td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>Medication Total</strong><br />
                                                <small class="text-muted">Prescribed medications and drugs</small>
                                            </td>
                                            <td class="text-end">$@Model.MedicationTotal.ToString("F2")</td>
                                        </tr>
                                        <tr class="table-success">
                                            <td class="text-end"><strong>TOTAL AMOUNT</strong></td>
                                            <td class="text-end">
                                                <h4 class="mb-0">$@Model.TotalAmount.ToString("F2")</h4>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="mb-3">
                                        <i class="bi bi-credit-card me-2"></i>PAYMENT INFORMATION
                                    </h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <strong>Payment Status:</strong><br />
                                            <span class="badge @(Model.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-danger")">
                                                @Model.PaymentStatus
                                            </span>
                                        </div>
                                        <div class="col-md-6">
                                            @if (Model.AmountPaid.HasValue && Model.AmountPaid > 0)
                                            {
                                                <div>
                                                    <strong>Amount Paid:</strong><br />
                                                    $@Model.AmountPaid.Value.ToString("F2")
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <div class="mt-4">
                                <small class="text-muted d-block mb-2">Thank you for your business!</small>
                                <div class="text-muted small">
                                    Please pay within 30 days<br />
                                    Late fees may apply after due date
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

          
            <div class="mt-4">
                <div class="btn-group-uniform">
                    <a asp-action="Patients" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Patients
                    </a>
                    <a asp-action="GenerateInvoice" asp-route-patientId="@Model.PatientId" 
                       class="btn btn-gradient-success">
                        <i class="bi bi-plus-circle me-1"></i> New Invoice
                    </a>
                    <button onclick="window.print()" class="btn btn-gradient-info">
                        <i class="bi bi-printer me-1"></i> Print Invoice
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
      
        const style = document.createElement('style');
        style.textContent = `
            @@media print {
                body * {
                    visibility: hidden;
                }
                #invoiceCard, #invoiceCard * {
                    visibility: visible;
                }
                #invoiceCard {
                    position: absolute;
                    left: 0;
                    top: 0;
                    width: 100%;
                    box-shadow: none !important;
                    border: 1px solid #ddd !important;
                }
                .btn-group-uniform {
                    display: none !important;
                }
                .d-flex.justify-content-between.align-items-center.mb-4 {
                    display: none !important;
                }
            }
            
            .badge-lg {
                font-size: 0.9rem;
                padding: 0.5rem 1rem;
                border-radius: 50px;
            }
            
            .btn-group-uniform {
                display: flex;
                gap: 10px;
                justify-content: center;
            }
            
            .btn-gradient-info { 
                background: linear-gradient(135deg, #90caf9, #047edf) !important;
                color: white !important;
                border: none;
            }
            
            .btn-gradient-success { 
                background: linear-gradient(135deg, #42e695, #3bb2b8) !important;
                color: white !important;
                border: none;
            }
            
            .table-success {
                background: linear-gradient(135deg, #d4edda, #c3e6cb) !important;
            }
        `;
        document.head.appendChild(style);
    </script>
}