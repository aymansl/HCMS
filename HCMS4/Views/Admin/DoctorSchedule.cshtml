@model HCMS4.ViewModels.DoctorScheduleViewModel

@{
    ViewData["Title"] = "Doctor's Schedule";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
           
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3">Doctor's Schedule</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item"><a asp-action="Doctors">Doctors</a></li>
                            <li class="breadcrumb-item active">Schedule</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="Doctors" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Doctors
                </a>
            </div>

            <div class="card dashboard-card mb-4">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h4 class="card-title mb-1">Dr. @Model.DoctorName</h4>
                            <p class="text-muted mb-0">
                                <i class="bi bi-briefcase me-1"></i>@Model.Specialization
                            </p>
                        </div>
                        <div class="col-md-6 text-end">
                            <a asp-action="BookAppointment" asp-route-doctorId="@Model.DoctorId" 
                               class="btn btn-primary">
                                <i class="bi bi-plus-circle me-1"></i>Book New Appointment
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="row mb-4">
                <div class="col-md-3 col-sm-6">
                    <div class="card dashboard-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-2">Total Appointments</h6>
                                    <h3 class="mb-0">@Model.TotalAppointments</h3>
                                </div>
                                <div class="header-icon bg-gradient-info">
                                    <i class="bi bi-calendar"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-3 col-sm-6">
                    <div class="card dashboard-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-2">Scheduled</h6>
                                    <h3 class="mb-0">@Model.ScheduledCount</h3>
                                </div>
                                <div class="header-icon bg-gradient-success">
                                    <i class="bi bi-clock"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-3 col-sm-6">
                    <div class="card dashboard-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-2">Completed</h6>
                                    <h3 class="mb-0">@Model.CompletedCount</h3>
                                </div>
                                <div class="header-icon bg-gradient-warning">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-3 col-sm-6">
                    <div class="card dashboard-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-2">Canceled</h6>
                                    <h3 class="mb-0">@Model.CanceledCount</h3>
                                </div>
                                <div class="header-icon bg-gradient-danger">
                                    <i class="bi bi-x-circle"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="card dashboard-card mb-4">
                <div class="card-body">
                    <ul class="nav nav-tabs nav-tabs-bordered" id="doctorTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link @(Model.SelectedStatus == "all" ? "active" : "")" 
                               asp-action="DoctorSchedule" asp-route-id="@Model.DoctorId" asp-route-status="all">
                                <i class="bi bi-list me-1"></i>All Appointments
                                <span class="badge bg-info ms-1">@Model.TotalAppointments</span>
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link @(Model.SelectedStatus == "Scheduled" ? "active" : "")" 
                               asp-action="DoctorSchedule" asp-route-id="@Model.DoctorId" asp-route-status="Scheduled">
                                <i class="bi bi-clock me-1"></i>Scheduled
                                <span class="badge bg-success ms-1">@Model.ScheduledCount</span>
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link @(Model.SelectedStatus == "Completed" ? "active" : "")" 
                               asp-action="DoctorSchedule" asp-route-id="@Model.DoctorId" asp-route-status="Completed">
                                <i class="bi bi-check-circle me-1"></i>Completed
                                <span class="badge bg-warning ms-1">@Model.CompletedCount</span>
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link @(Model.SelectedStatus == "Canceled" ? "active" : "")" 
                               asp-action="DoctorSchedule" asp-route-id="@Model.DoctorId" asp-route-status="Canceled">
                                <i class="bi bi-x-circle me-1"></i>Canceled
                                <span class="badge bg-danger ms-1">@Model.CanceledCount</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            @if (Model.SelectedStatus == "all")
            {
               
                @if (Model.TodayAppointments.Any())
                {
                    <div class="card dashboard-card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-calendar-day me-2"></i>Today's Appointments
                                <span class="badge bg-info ms-2">@Model.TodayAppointments.Count</span>
                            </h5>
                            <span class="text-muted">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Time</th>
                                            <th>Patient</th>
                                            <th>Contact</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in Model.TodayAppointments)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@appointment.AppointmentDateTime.ToString("hh:mm tt")</strong>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong>@appointment.Patient?.User?.FullName</strong>
                                                            <div class="text-muted small">@appointment.Patient?.User?.Email</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(appointment.Patient?.User?.PhoneNumber))
                                                    {
                                                        <div>
                                                            <i class="bi bi-telephone me-1"></i>
                                                            @appointment.Patient.User.PhoneNumber
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No phone</span>
                                                    }
                                                </td>
                                                <td>
                                                    @await Html.PartialAsync("_AppointmentStatusBadge", appointment.Status)
                                                </td>
                                                <td>
                                                    <div class="btn-group-uniform">
                                                        @if (appointment.Status == AppointmentStatus.Scheduled)
                                                        {
                                                            <a asp-action="RescheduleAppointment" asp-route-id="@appointment.Id" 
                                                               class="btn btn-gradient-warning btn-icon" title="Reschedule">
                                                                <i class="bi bi-calendar-week"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-gradient-danger btn-icon cancel-btn" 
                                                                    title="Cancel Appointment"
                                                                    data-appointment-id="@appointment.Id"
                                                                    data-patient-name="@appointment.Patient?.User?.FullName">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        }
                                                        <a asp-action="PatientDetails" asp-route-id="@appointment.PatientId" 
                                                           class="btn btn-gradient-info btn-icon" title="View Patient">
                                                            <i class="bi bi-person"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                
                @if (Model.UpcomingAppointments.Any())
                {
                    <div class="card dashboard-card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="bi bi-calendar-week me-2"></i>Upcoming Appointments
                                <span class="badge bg-success ms-2">@Model.UpcomingAppointments.Count</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date & Time</th>
                                            <th>Patient</th>
                                            <th>Contact</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in Model.UpcomingAppointments)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@appointment.AppointmentDateTime.ToString("MMM dd, yyyy")</strong>
                                                    <div class="text-muted small">@appointment.AppointmentDateTime.ToString("hh:mm tt")</div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong>@appointment.Patient?.User?.FullName</strong>
                                                            <div class="text-muted small">@appointment.Patient?.User?.Email</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(appointment.Patient?.User?.PhoneNumber))
                                                    {
                                                        <div>
                                                            <i class="bi bi-telephone me-1"></i>
                                                            @appointment.Patient.User.PhoneNumber
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No phone</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-clock me-1"></i>Scheduled
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group-uniform">
                                                        <a asp-action="RescheduleAppointment" asp-route-id="@appointment.Id" 
                                                           class="btn btn-gradient-warning btn-icon" title="Reschedule">
                                                            <i class="bi bi-calendar-week"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-gradient-danger btn-icon cancel-btn" 
                                                                title="Cancel Appointment"
                                                                data-appointment-id="@appointment.Id"
                                                                data-patient-name="@appointment.Patient?.User?.FullName">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                        <a asp-action="PatientDetails" asp-route-id="@appointment.PatientId" 
                                                           class="btn btn-gradient-info btn-icon" title="View Patient">
                                                            <i class="bi bi-person"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                
            }
            else
            {
               
                <div class="card dashboard-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-filter me-2"></i>@Model.SelectedStatus Appointments
                            <span class="badge bg-info ms-2">@Model.FilteredAppointments.Count</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.FilteredAppointments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date & Time</th>
                                            <th>Patient</th>
                                            <th>Contact</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in Model.FilteredAppointments)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@appointment.AppointmentDateTime.ToString("MMM dd, yyyy")</strong>
                                                    <div class="text-muted small">@appointment.AppointmentDateTime.ToString("hh:mm tt")</div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong>@appointment.Patient?.User?.FullName</strong>
                                                            <div class="text-muted small">@appointment.Patient?.User?.Email</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(appointment.Patient?.User?.PhoneNumber))
                                                    {
                                                        <div>
                                                            <i class="bi bi-telephone me-1"></i>
                                                            @appointment.Patient.User.PhoneNumber
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No phone</span>
                                                    }
                                                </td>
                                                <td>
                                                    @await Html.PartialAsync("_AppointmentStatusBadge", appointment.Status)
                                                </td>
                                                <td>
                                                    @if (appointment.Status == AppointmentStatus.Scheduled)
                                                    {
                                                        <div class="btn-group-uniform">
                                                            <a asp-action="RescheduleAppointment" asp-route-id="@appointment.Id" 
                                                               class="btn btn-gradient-warning btn-icon" title="Reschedule">
                                                                <i class="bi bi-calendar-week"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-gradient-danger btn-icon cancel-btn" 
                                                                    title="Cancel Appointment"
                                                                    data-appointment-id="@appointment.Id"
                                                                    data-patient-name="@appointment.Patient?.User?.FullName">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                            <a asp-action="PatientDetails" asp-route-id="@appointment.PatientId" 
                                                               class="btn btn-gradient-info btn-icon" title="View Patient">
                                                                <i class="bi bi-person"></i>
                                                            </a>
                                                        </div>
                                                    }
                                                    else if (appointment.Status == AppointmentStatus.Canceled && !string.IsNullOrEmpty(appointment.CancellationReason))
                                                    {
                                                        <button type="button" class="btn btn-gradient-info btn-icon view-reason-btn"
                                                                title="View Cancellation Reason"
                                                                data-reason="@appointment.CancellationReason">
                                                            <i class="bi bi-info-circle"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <a asp-action="PatientDetails" asp-route-id="@appointment.PatientId" 
                                                           class="btn btn-gradient-info btn-icon" title="View Patient">
                                                            <i class="bi bi-person"></i>
                                                        </a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-calendar-x display-1 text-muted"></i>
                                <h4 class="mt-3">No @Model.SelectedStatus Appointments</h4>
                                <p class="text-muted">No @Model.SelectedStatus.ToLower() appointments found for Dr. @Model.DoctorName.</p>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (!Model.HasAppointments)
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-1 text-muted"></i>
                    <h4 class="mt-3">No Appointments</h4>
                    <p class="text-muted">No appointments found for Dr. @Model.DoctorName.</p>
                    <a asp-action="BookAppointment" asp-route-doctorId="@Model.DoctorId" 
                       class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Book First Appointment
                    </a>
                </div>
            }
        </div>
    </div>
</div>


<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancel Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="cancelForm" asp-action="CancelAppointment" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="id" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="cancellationReason" class="form-label">Cancellation Reason</label>
                        <textarea class="form-control" id="cancellationReason" name="cancellationReason" 
                                  rows="3" placeholder="Please provide a reason for cancellation..." required></textarea>
                        <div class="invalid-feedback">Please provide a cancellation reason.</div>
                    </div>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Note:</strong> Appointments cannot be canceled less than 24 hours before the scheduled time.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Cancel Appointment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
        
            document.querySelectorAll('.cancel-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const appointmentId = this.getAttribute('data-appointment-id');
                    const patientName = this.getAttribute('data-patient-name');
               
                    Swal.fire({
                        title: 'Cancel Appointment?',
                        html: `Are you sure you want to cancel appointment for <strong>${patientName}</strong>?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#fe7096',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, Cancel',
                        cancelButtonText: 'No, Keep'
                    }).then((result) => {
                        if (result.isConfirmed) {
                   
                            document.getElementById('id').value = appointmentId;
                            document.getElementById('cancellationReason').value = '';
                            const modal = new bootstrap.Modal(document.getElementById('cancelModal'));
                            modal.show();
                        }
                    });
                });
            });
        });
    </script>
}