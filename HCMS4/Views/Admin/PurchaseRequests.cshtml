<!-- Views/Admin/PurchaseRequests.cshtml -->
@model HCMS4.ViewModels.AdminPurchaseRequestListViewModel

@{
    ViewData["Title"] = "Purchase Requests - Admin";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3">
                        <i class="bi bi-cart-check me-2 text-primary"></i>
                        Purchase Request Approvals
                    </h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item active">Purchase Requests</li>
                        </ol>
                    </nav>
                </div>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Summary Cards -->
            <div class="row mb-4">
                <div class="col-md-2">
                    <div class="card dashboard-card bg-primary text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-white-50 mb-1">Pending</h6>
                                    <h3 class="mb-0">@Model.PendingCount</h3>
                                </div>
                                <i class="bi bi-clock-history fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card bg-success text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-white-50 mb-1">Approved</h6>
                                    <h3 class="mb-0">@Model.ApprovedCount</h3>
                                </div>
                                <i class="bi bi-check-circle fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card bg-danger text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-white-50 mb-1">Rejected</h6>
                                    <h3 class="mb-0">@Model.RejectedCount</h3>
                                </div>
                                <i class="bi bi-x-circle fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card bg-warning text-dark">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-dark-50 mb-1">Ordered</h6>
                                    <h3 class="mb-0">@Model.OrderedCount</h3>
                                </div>
                                <i class="bi bi-truck fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card bg-info text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-white-50 mb-1">Received</h6>
                                    <h3 class="mb-0">@Model.ReceivedCount</h3>
                                </div>
                                <i class="bi bi-box-seam fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card dashboard-card bg-secondary text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-white-50 mb-1">Total</h6>
                                    <h3 class="mb-0">@Model.PurchaseRequests.Count</h3>
                                </div>
                                <i class="bi bi-list-ul fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Filter Tabs -->
            <div class="card dashboard-card mb-4">
                <div class="card-body">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <a class="nav-link @(Model.SelectedStatus == "all" ? "active" : "")"
                               asp-action="PurchaseRequests" asp-route-status="all">
                                <i class="bi bi-list-ul me-1"></i> All
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.SelectedStatus == "Pending" ? "active" : "")"
                               asp-action="PurchaseRequests" asp-route-status="Pending">
                                <i class="bi bi-clock-history me-1"></i> Pending
                                @if (Model.PendingCount > 0)
                                {
                                    <span class="badge bg-danger ms-1">@Model.PendingCount</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.SelectedStatus == "Approved" ? "active" : "")"
                               asp-action="PurchaseRequests" asp-route-status="Approved">
                                <i class="bi bi-check-circle me-1"></i> Approved
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.SelectedStatus == "Rejected" ? "active" : "")"
                               asp-action="PurchaseRequests" asp-route-status="Rejected">
                                <i class="bi bi-x-circle me-1"></i> Rejected
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.SelectedStatus == "Ordered" ? "active" : "")"
                               asp-action="PurchaseRequests" asp-route-status="Ordered">
                                <i class="bi bi-truck me-1"></i> Ordered
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.SelectedStatus == "Received" ? "active" : "")"
                               asp-action="PurchaseRequests" asp-route-status="Received">
                                <i class="bi bi-box-seam me-1"></i> Received
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Purchase Requests Table -->
            <div class="card dashboard-card">
                <div class="card-body">
                    @if (Model.PurchaseRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Request #</th>
                                        <th>Date</th>
                                        <th>Pharmacist</th>
                                        <th>Supplier</th>
                                        <th>Items</th>
                                        <th>Total Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.PurchaseRequests)
                                    {
                                        <tr class="@(request.Status == PurchaseRequestStatus.Pending ? "table-warning" : "")">
                                            <td class="fw-bold">@request.RequestNumber</td>
                                            <td>@request.RequestDate.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@request.Pharmacist?.User?.FirstName @request.Pharmacist?.User?.LastName</td>
                                            <td>@(request.Supplier?.Name ?? "Not Specified")</td>
                                            <td>@request.Items.Count items</td>
                                            <td class="text-success fw-bold">@request.TotalAmount.ToString("C2")</td>
                                            <td>
                                                @{
                                                    var statusClass = request.Status switch
                                                    {
                                                        PurchaseRequestStatus.Pending => "bg-warning text-dark",
                                                        PurchaseRequestStatus.Approved => "bg-success",
                                                        PurchaseRequestStatus.Rejected => "bg-danger",
                                                        PurchaseRequestStatus.Ordered => "bg-warning",
                                                        PurchaseRequestStatus.Received => "bg-info",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @statusClass">@request.Status</span>
                                            </td>
                                            <td>
                                                <a asp-action="PurchaseRequestDetails" asp-route-id="@request.Id"
                                                   class="btn btn-sm btn-info" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-cart display-1 text-muted"></i>
                            <h4 class="mt-3">No Purchase Requests Found</h4>
                            <p class="text-muted">
                                @if (Model.SelectedStatus != "all")
                                {
                                    <text>No @Model.SelectedStatus purchase requests available.</text>
                                }
                                else
                                {
                                    <text>No purchase requests in the system.</text>
                                }
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
        transition: transform 0.2s;
    }

    .dashboard-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
    }

    .nav-tabs .nav-link {
        color: #495057;
        border: none;
        padding: 0.75rem 1.5rem;
    }

    .nav-tabs .nav-link:hover {
        border: none;
        color: #667eea;
    }

    .nav-tabs .nav-link.active {
        color: #667eea;
        border-bottom: 3px solid #667eea;
        background: transparent;
        font-weight: 500;
    }

    .bg-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important; }
    .bg-success { background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%) !important; }
    .bg-danger { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%) !important; }
    .bg-warning { background: linear-gradient(135deg, #f6d365 0%, #fda085 100%) !important; }
    .bg-info { background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%) !important; }
    .bg-secondary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important; }

    .text-white-50 { color: rgba(255,255,255,0.7) !important; }
    .text-dark-50 { color: rgba(0,0,0,0.6) !important; }
</style>