@model List<HCMS4.Models.Complaint>

@{
    ViewData["Title"] = "Complaints";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <h1 class="h3 mb-4">Complaints Review</h1>
    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Tracking #</th>
                                <th>Patient</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Submitted</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var complaint in Model)
                            {
                                <tr>
                                    <td>@complaint.TrackingNumber</td>
                                    <td>@complaint.Patient?.User?.FullName</td>
                                    <td>@complaint.Title</td>
                                    <td><span class="badge bg-secondary">@complaint.Status</span></td>
                                    <td>@complaint.SubmissionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <a asp-action="ComplaintDetails" asp-route-id="@complaint.Id" class="btn btn-sm btn-primary">Review</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No complaints found.</p>
            }
        </div>
    </div>
</div>
