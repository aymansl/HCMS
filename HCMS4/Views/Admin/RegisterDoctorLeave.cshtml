@model HCMS4.ViewModels.RegisterDoctorLeaveViewModel

@{
    ViewData["Title"] = "Register Doctor Leave";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card dashboard-card">
                <div class="card-header bg-white">
                    <h4 class="mb-0">
                        <i class="bi bi-calendar-x me-2 text-warning"></i>
                        Register Doctor Leave
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (ViewBag.ShowWarning == true)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> @ViewBag.WarningMessage
                            <br />
                            <small>You may want to reschedule or notify patients about the change.</small>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="mb-4">
                        <h5>Doctor Information</h5>
                        <table class="table table-borderless">
                            <tr>
                                <td class="fw-bold">Doctor Name:</td>
                                <td>@Model.DoctorName</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Doctor ID:</td>
                                <td>@Model.DoctorId</td>
                            </tr>
                        </table>
                    </div>

                    <form asp-action="RegisterDoctorLeave" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DoctorId" />
                        <input type="hidden" asp-for="DoctorName" />

                        <div class="mb-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input type="date" asp-for="StartDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input type="date" asp-for="EndDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LeaveType" class="form-label"></label>
                            <select asp-for="LeaveType" class="form-select" asp-items="Html.GetEnumSelectList<HCMS4.Models.LeaveType>()" required>
                                <option value="">-- Select Leave Type --</option>
                            </select>
                            <span asp-validation-for="LeaveType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Doctors" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save me-1"></i> Save Leave
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const startDate = document.getElementById('StartDate');
            const endDate = document.getElementById('EndDate');

            startDate.addEventListener('change', function() {
                endDate.min = this.value;
                if (endDate.value && endDate.value < this.value) {
                    endDate.value = this.value;
                }
            });
        });
    </script>
}
