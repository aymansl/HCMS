@model IEnumerable<HCMS4.Models.Specialization>

@{
    ViewData["Title"] = "Price List & Services";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3">Price List & Services</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item active">Price List</li>
                        </ol>
                    </nav>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row mb-4">
                <div class="col-md-4 col-sm-6">
                    <div class="card dashboard-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-2">Total Specializations</h6>
                                    <h3 class="mb-0">@Model.Count()</h3>
                                </div>
                                <div class="header-icon bg-gradient-success">
                                    <i class="bi bi-grid-3x3-gap"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <div class="card dashboard-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-2">Active Specializations</h6>
                                    <h3 class="mb-0">@Model.Count(s => s.IsActive)</h3>
                                </div>
                                <div class="header-icon bg-gradient-info">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <div class="card dashboard-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-2">Average Fee</h6>
                                    <h3 class="mb-0">@Model.Average(s => s.ConsultationFee).ToString("C0")</h3>
                                </div>
                                <div class="header-icon bg-gradient-primary">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card dashboard-card">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-cash-coin me-2 text-primary"></i>
                        Consultation Fees by Specialization
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Specialization Name</th>
                                        <th>Description</th>
                                        <th>Current Fee</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var spec in Model)
                                    {
                                        <tr>
                                            <td>@spec.Id</td>
                                            <td>
                                                <strong>@spec.Name</strong>
                                            </td>
                                            <td>
                                                <span class="text-muted small">@spec.Description</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-success fs-6">@spec.ConsultationFee.ToString("C2")</span>
                                            </td>
                                            <td>
                                                @if (spec.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-gradient-primary btn-icon"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editFeeModal"
                                                        data-spec-id="@spec.Id"
                                                        data-spec-name="@spec.Name"
                                                        data-spec-fee="@spec.ConsultationFee"
                                                        title="Edit Fee">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-grid-3x3-gap display-1 text-muted"></i>
                            <h4 class="mt-3">No Specializations Found</h4>
                            <p class="text-muted">No medical specializations have been configured.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Fee Modal -->
<div class="modal fade" id="editFeeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Consultation Fee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateSpecializationFee" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editSpecId" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted">Specialization</label>
                        <h5 id="editSpecName" class="mb-0"></h5>
                    </div>
                    <div class="mb-3">
                        <label for="editConsultationFee" class="form-label">New Consultation Fee *</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" id="editConsultationFee" name="consultationFee" 
                                   class="form-control" step="0.01" min="0.01" required />
                        </div>
                        <small class="text-muted">Enter a value greater than zero</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>Update Fee
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var editFeeModal = document.getElementById('editFeeModal');
            editFeeModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                
                var specId = button.getAttribute('data-spec-id');
                var specName = button.getAttribute('data-spec-name');
                var specFee = button.getAttribute('data-spec-fee');
                
                var modalSpecName = editFeeModal.querySelector('#editSpecName');
                var modalSpecId = editFeeModal.querySelector('#editSpecId');
                var modalFeeInput = editFeeModal.querySelector('#editConsultationFee');
                
                modalSpecName.textContent = specName;
                modalSpecId.value = specId;
                modalFeeInput.value = specFee;
            });
        });
    </script>
}
