@model HCMS4.ViewModels.PharmacistRegisterViewModel

@{
    ViewData["Title"] = "Create Pharmacist Account";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3">Create New Pharmacist Account</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item"><a asp-action="Pharmacists">Pharmacists</a></li>
                            <li class="breadcrumb-item active">Create Pharmacist</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="Pharmacists" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>

            <div class="card dashboard-card">
                <div class="card-header bg-gradient-primary text-white">
                    <h4 class="mb-0">Pharmacist Information</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreatePharmacist" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Personal Information -->
                        <h5 class="mb-3 text-primary">Personal Information</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="FirstName" class="form-label">First Name *</label>
                                    <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="LastName" class="form-label">Last Name *</label>
                                    <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="Email" class="form-label">Email *</label>
                                    <input asp-for="Email" class="form-control" type="email" placeholder="Enter email address" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Professional Information -->
                        <h5 class="mb-3 mt-4 text-primary">Professional Information</h5>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="ContactInfo" class="form-label">Contact Information</label>
                                    <input asp-for="ContactInfo" class="form-control" placeholder="Phone number" />
                                    <span asp-validation-for="ContactInfo" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Shift" class="form-label">Shift</label>
                                    <select asp-for="Shift" class="form-select">
                                        <option value="">Select Shift</option>
                                        <option value="Morning">Morning (8 AM - 4 PM)</option>
                                        <option value="Evening">Evening (4 PM - 12 AM)</option>
                                        <option value="Night">Night (12 AM - 8 AM)</option>
                                    </select>
                                    <span asp-validation-for="Shift" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Qualifications" class="form-label">Qualifications</label>
                                    <input asp-for="Qualifications" class="form-control" placeholder="e.g., B.Pharm, M.Pharm" />
                                    <span asp-validation-for="Qualifications" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Account Credentials -->
                        <h5 class="mb-3 mt-4 text-primary">Account Credentials</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Password" class="form-label">Password *</label>
                                    <input asp-for="Password" class="form-control" type="password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                    <small class="text-muted">Minimum 6 characters with uppercase, lowercase, and number</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password *</label>
                                    <input asp-for="ConfirmPassword" class="form-control" type="password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="d-flex justify-content-between">
                                    <a asp-action="Pharmacists" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-1"></i>Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-person-plus me-1"></i>Create Pharmacist Account
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}