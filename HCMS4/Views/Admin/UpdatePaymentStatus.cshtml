@model HCMS4.Models.Invoice

@{
    ViewData["Title"] = "Update Payment Status";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3">
                        <i class="bi bi-credit-card me-2"></i>Update Payment Status
                    </h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item"><a asp-action="ManageInvoices">Invoices</a></li>
                            <li class="breadcrumb-item active">Update Payment</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <a asp-action="ManageInvoices" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Invoices
                    </a>
                </div>
            </div>

            <!-- Display Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row">
                <!-- Invoice Summary Card -->
                <div class="col-lg-5 mb-4">
                    <div class="card dashboard-card h-100">
                        <div class="card-header bg-gradient-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-receipt me-2"></i>Invoice Summary
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-6">
                                    <div class="info-box p-3 bg-light rounded">
                                        <small class="text-muted">Invoice #</small>
                                        <h4 class="mb-0">@Model.Id</h4>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="info-box p-3 bg-light rounded">
                                        <small class="text-muted">Invoice Date</small>
                                        <h4 class="mb-0">@Model.InvoiceDate.ToString("dd MMM yyyy")</h4>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="info-box p-3 bg-light rounded">
                                    <small class="text-muted">Patient</small>
                                    <h5 class="mb-0">@Model.Patient?.User?.FullName</h5>
                                    <small class="text-muted">@Model.Patient?.User?.Email</small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="info-box p-3 bg-light rounded">
                                    <small class="text-muted">Current Status</small>
                                    <div>
                                        @if (Model.PaymentStatus == PaymentStatus.Pending)
                                        {
                                            <span class="badge bg-warning px-3 py-2">
                                                <i class="bi bi-clock-history"></i> Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-circle"></i> Paid
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <div class="billing-details">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Consultation Fee:</span>
                                    <span class="fw-bold">@Model.ConsultationFee.ToString("C2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Medication Total:</span>
                                    <span class="fw-bold">@Model.MedicationTotal.ToString("C2")</span>
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fs-5 fw-bold">Total Amount:</span>
                                    <span class="fs-5 fw-bold text-primary">@Model.TotalAmount.ToString("C2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Amount Paid:</span>
                                    <span class="fw-bold @(Model.AmountPaid.HasValue && Model.AmountPaid > 0 ? "text-success" : "text-muted")">
                                        @(Model.AmountPaid?.ToString("C2") ?? "$0.00")
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Amount Due:</span>
                                    <span class="fw-bold @(Model.TotalAmount - (Model.AmountPaid ?? 0) > 0 ? "text-danger" : "text-success")">
                                        @((Model.TotalAmount - (Model.AmountPaid ?? 0)).ToString("C2"))
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Update Form -->
                <div class="col-lg-7">
                    <div class="card dashboard-card">
                        <div class="card-header bg-gradient-info text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-cash-coin me-2"></i>Update Payment Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="UpdatePaymentStatus" method="post" id="paymentForm">
                                @Html.AntiForgeryToken()

                                <!-- Payment Status Selection -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">Payment Status *</label>
                                    <select name="PaymentStatus" class="form-select form-select-lg" id="paymentStatusSelect" required>
                                        <option value="">-- Select Status --</option>
                                        <option value="@((int)PaymentStatus.Pending)">Pending</option>
                                        <option value="@((int)PaymentStatus.Paid)">Paid - Full Amount</option>
                                    </select>
                                    <div class="form-text mt-2">
                                        <i class="bi bi-info-circle"></i> Select "Paid" to mark this invoice as fully paid.
                                    </div>
                                </div>

                                <!-- Amount Paid Section (only shown for Paid status) -->
                                <div class="mb-4" id="amountPaidSection" style="display: none;">
                                    <label class="form-label fw-bold">Payment Details</label>
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <label class="form-label">Amount Paid *</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text">$</span>
                                                        <input type="number" name="AmountPaid" class="form-control"
                                                               id="amountPaidInput"
                                                               step="0.01" min="0"
                                                               max="@Model.TotalAmount"
                                                               placeholder="0.00">
                                                    </div>
                                                    <div class="form-text">
                                                        Enter the amount received (must equal total amount).
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Payment Date</label>
                                                    <input type="date" name="PaymentDate" class="form-control"
                                                           id="paymentDateInput"
                                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                                           max="@DateTime.Now.ToString("yyyy-MM-dd")">
                                                    <div class="form-text">Date when payment was received.</div>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <div class="alert alert-warning mb-0">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <i class="bi bi-calculator"></i>
                                                            <strong>Total Amount Due:</strong>
                                                            <span class="ms-2">@Model.TotalAmount.ToString("C2")</span>
                                                        </div>
                                                        <div id="remainingBalanceDisplay">
                                                            <strong>Remaining:</strong>
                                                            <span class="text-danger">@Model.TotalAmount.ToString("C2")</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Notes -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat-left-text me-1"></i>Payment Notes
                                    </label>
                                    <textarea name="Notes" class="form-control" rows="3"
                                              placeholder="Add payment method (cash, card, bank transfer), reference number, or other notes..."></textarea>
                                    <div class="form-text">Optional: Add payment details for reference.</div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <button type="button" class="btn btn-outline-info" onclick="markAsFullyPaid()">
                                            <i class="bi bi-check-all me-1"></i>Mark as Fully Paid
                                        </button>
                                    </div>
                                    <div>
                                        <a asp-action="ManageInvoices" class="btn btn-outline-secondary me-2">
                                            <i class="bi bi-x-circle me-1"></i>Cancel
                                        </a>
                                        <button type="submit" class="btn btn-gradient-success">
                                            <i class="bi bi-check-circle me-1"></i>Update Payment
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const paymentStatusSelect = document.getElementById('paymentStatusSelect');
            const amountPaidSection = document.getElementById('amountPaidSection');
            const amountPaidInput = document.getElementById('amountPaidInput');
            const paymentDateInput = document.getElementById('paymentDateInput');
            const totalAmount = @Model.TotalAmount;

            function toggleAmountPaidSection() {
                const status = paymentStatusSelect.value;

                if (status === '@((int)PaymentStatus.Pending)') {
                    amountPaidSection.style.display = 'none';
                    amountPaidInput.required = false;
                    amountPaidInput.value = '';
                } else if (status === '@((int)PaymentStatus.Paid)') {
                    amountPaidSection.style.display = 'block';
                    amountPaidInput.required = true;
                    amountPaidInput.value = totalAmount;
                    if (!paymentDateInput.value) {
                        paymentDateInput.value = new Date().toISOString().split('T')[0];
                    }
                }

                updateRemainingBalance();
            }

            function updateRemainingBalance() {
                const amountPaid = parseFloat(amountPaidInput.value) || 0;
                const remaining = totalAmount - amountPaid;
                const remainingDisplay = document.getElementById('remainingBalanceDisplay');

                if (remainingDisplay) {
                    const remainingSpan = remainingDisplay.querySelector('span');
                    if (remainingSpan) {
                        remainingSpan.textContent = remaining.toFixed(2);
                        remainingSpan.className = remaining > 0 ? 'text-danger' : 'text-success';
                    }
                    remainingDisplay.innerHTML = `<strong>Remaining:</strong> <span class="${remaining > 0 ? 'text-danger' : 'text-success'}">${remaining.toFixed(2)}</span>`;
                }
            }

            // Initial toggle
            toggleAmountPaidSection();

            // Event listeners
            paymentStatusSelect.addEventListener('change', toggleAmountPaidSection);
            amountPaidInput.addEventListener('input', updateRemainingBalance);

            // Form validation
            document.getElementById('paymentForm').addEventListener('submit', function(e) {
                const status = paymentStatusSelect.value;
                const amountPaid = parseFloat(amountPaidInput.value) || 0;
                const currentStatus = '@Model.PaymentStatus';

                // Check if invoice is already paid
                if (currentStatus === '@PaymentStatus.Paid') {
                    e.preventDefault();
                    alert('This invoice is already marked as Paid and cannot be modified.');
                    return false;
                }

                // Validate status selection
                if (!status) {
                    e.preventDefault();
                    alert('Please select a payment status.');
                    return false;
                }

                // Validate paid status
                if (status === '@((int)PaymentStatus.Paid)') {
                    if (amountPaid !== totalAmount) {
                        e.preventDefault();
                        alert(`For "Paid" status, amount paid must equal the total amount (${totalAmount.toFixed(2)}).`);
                        return false;
                    }
                }
            });
        });

        function markAsFullyPaid() {
            const paymentStatusSelect = document.getElementById('paymentStatusSelect');
            const amountPaidInput = document.getElementById('amountPaidInput');
            const paymentDateInput = document.getElementById('paymentDateInput');
            const totalAmount = @Model.TotalAmount;

            paymentStatusSelect.value = '@((int)PaymentStatus.Paid)';
            amountPaidInput.value = totalAmount;
            paymentDateInput.value = new Date().toISOString().split('T')[0];

            // Trigger the change event
            const event = new Event('change');
            paymentStatusSelect.dispatchEvent(event);

            alert('Form has been auto-filled for full payment. Click "Update Payment" to confirm.');
        }
    </script>
}

<style>
    .dashboard-card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
        transition: transform 0.2s;
    }

        .dashboard-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
        }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #90caf9, #047edf) !important;
    }

    .btn-gradient-success {
        background: linear-gradient(135deg, #42e695, #3bb2b8) !important;
        color: white !important;
        border: none;
    }

        .btn-gradient-success:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(66, 230, 149, 0.3);
        }

    .info-box {
        border-left: 4px solid #0d6efd;
    }

    .form-select-lg {
        font-size: 1rem;
        padding: 0.5rem 1rem;
    }

    .badge.bg-warning {
        background-color: #ffc107 !important;
        color: #212529;
        padding: 8px 16px;
        font-size: 0.9rem;
    }

    .badge.bg-success {
        background-color: #28a745 !important;
        padding: 8px 16px;
        font-size: 0.9rem;
    }
</style>