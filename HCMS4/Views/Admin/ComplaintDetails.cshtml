@model HCMS4.Models.Complaint

@{
    ViewData["Title"] = "Complaint Details";
    Layout = "_LayoutAuth";
}

<div class="container py-4">
    <div class="card dashboard-card">
        <div class="card-header">
            <h4 class="mb-0">Complaint @Model.TrackingNumber</h4>
        </div>
        <div class="card-body">
            <div class="mb-3"><strong>Patient:</strong> @Model.Patient?.User?.FullName</div>
            <div class="mb-3"><strong>Type:</strong> @Model.Type</div>
            <div class="mb-3"><strong>Title:</strong> @Model.Title</div>
            <div class="mb-3"><strong>Description:</strong> @Model.Description</div>
            @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
            {
                <div class="mb-3"><a href="@Model.AttachmentPath" target="_blank">View attachment</a></div>
            }

            <form asp-action="UpdateComplaintStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <select name="status" asp-items="Html.GetEnumSelectList<HCMS4.Models.ComplaintStatus>()" class="form-select"></select>
                </div>
                <div class="mb-4">
                    <label class="form-label">Resolution Notes</label>
                    <textarea name="resolutionNotes" class="form-control" rows="4">@Model.ResolutionNotes</textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update Complaint</button>
                    <a asp-action="Complaints" class="btn btn-outline-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>
