@model IEnumerable<HCMS4.Models.Doctor>

@{
    ViewData["Title"] = "Manage Doctors";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3">Manage Doctors</h1>
                <a asp-action="CreateDoctor" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create New Doctor
                </a>
            </div>

       
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

         
            <div class="card">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Specialization</th>
                                        <th>Contact</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doctor in Model)
                                    {
                                        <tr>
                                            <td>@doctor.Id</td>
                                            <td>@doctor.FullName</td>
                                            <td>@doctor.User?.Email</td>
                                            <td>@doctor.Specialization?.Name</td>
                                            <td>@doctor.ContactInfo</td>
                                            <td>
                                                <div class="btn-group-uniform">
                                                    <a asp-action="DoctorSchedule" asp-route-id="@doctor.Id" class="btn btn-gradient-info btn-icon" title="View doctor's daily schedule">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-action="RegisterDoctorLeave" asp-route-id="@doctor.Id" class="btn btn-gradient-warning btn-icon" title="Register Leave">
                                                        <i class="bi bi-calendar-x"></i>
                                                    </a>
                                                    <a asp-action="ViewDoctorLeaves" asp-route-id="@doctor.Id" class="btn btn-gradient-secondary btn-icon" title="View Leave History">
                                                        <i class="bi bi-clock-history"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-gradient-danger btn-icon delete-btn" 
                                                            title="Delete Doctor"
                                                            data-doctor-id="@doctor.UserId"
                                                            data-doctor-name="@doctor.FullName">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-people display-1 text-muted"></i>
                            <h4 class="mt-3">No Doctors Found</h4>
                            <p class="text-muted">No doctor accounts have been created yet.</p>
                            <a asp-action="CreateDoctor" class="btn btn-primary">Create First Doctor</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    
    document.querySelectorAll('.delete-btn').forEach(button => {
        button.addEventListener('click', function() {
            const doctorId = this.getAttribute('data-doctor-id');
            const doctorName = this.getAttribute('data-doctor-name');
            
            confirmDelete(doctorId, doctorName);
        });
    });
});

async function confirmDelete(doctorId, doctorName) {
    const { isConfirmed } = await Swal.fire({
        title: 'Delete Doctor?',
        html: `Delete <strong>${doctorName}</strong> permanently?<br>
               <span class="text-danger small">
                 <i class="bi bi-exclamation-triangle-fill me-1"></i>
                 This action cannot be undone
               </span>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#fe7096',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Delete',
        cancelButtonText: 'Cancel',
        reverseButtons: true,
        width: '500px',
        customClass: {
            popup: 'rounded-3',
            confirmButton: 'btn btn-gradient-danger px-4 py-2',
            cancelButton: 'btn btn-outline-secondary px-4 py-2'
        },
        buttonsStyling: false
    });
    
    if (isConfirmed) {
        
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Admin/DeleteUser'; 
        form.style.display = 'none';
        
 
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            const csrfInput = document.createElement('input');
            csrfInput.type = 'hidden';
            csrfInput.name = '__RequestVerificationToken';
            csrfInput.value = token.value;
            form.appendChild(csrfInput);
        }
    
        const idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = 'id';
        idInput.value = doctorId;
        form.appendChild(idInput);
        
 
        document.body.appendChild(form);
        form.submit();
    }
}

const style = document.createElement('style');
style.textContent = `
    .btn-gradient-danger {
        background: linear-gradient(to right, #ffbf96, #fe7096) !important;
        color: white !important;
        border: none !important;
        border-radius: 10px !important;
        font-weight: 500 !important;
        transition: all 0.3s ease !important;
    }
    
    .btn-gradient-danger:hover {
        transform: translateY(-2px) !important;
        box-shadow: 0 4px 15px rgba(254, 112, 150, 0.4) !important;
    }
    
    .btn-outline-secondary {
        border: 1px solid #dee2e6 !important;
        border-radius: 10px !important;
        font-weight: 500 !important;
    }
`;
document.head.appendChild(style);
</script>