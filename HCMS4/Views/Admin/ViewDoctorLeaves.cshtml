@model HCMS4.ViewModels.DoctorLeaveViewModel

@{
    ViewData["Title"] = "Doctor Leave History";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3">
                        <i class="bi bi-clock-history me-2"></i>
                        Doctor Leave History
                    </h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Doctors">Doctors</a></li>
                            <li class="breadcrumb-item active">@Model.DoctorName - Leave History</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <a asp-action="RegisterDoctorLeave" asp-route-id="@Model.DoctorId" class="btn btn-warning me-2">
                        <i class="bi bi-plus-circle"></i> Register Leave
                    </a>
                    <a asp-action="Doctors" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.LeaveRequests.Any())
            {
                <div class="card dashboard-card mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-hourglass-split me-2"></i>
                            Pending Leave Requests
                            <span class="badge bg-warning ms-2">@Model.LeaveRequests.Count</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Leave Type</th>
                                        <th>Reason</th>
                                        <th>Status</th>
                                        <th>Requested On</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.LeaveRequests)
                                    {
                                        <tr>
                                            <td class="fw-bold">#@request.Id</td>
                                            <td>@request.StartDate.ToString("yyyy-MM-dd")</td>
                                            <td>@request.EndDate.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <span class="badge bg-info">@request.LeaveType</span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(request.Reason))
                                                {
                                                    <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@request.Reason">
                                                        @request.Reason
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (request.Status == HCMS4.Models.LeaveStatus.Pending)
                                                {
                                                    <span class="badge bg-warning">Pending</span>
                                                }
                                                else if (request.Status == HCMS4.Models.LeaveStatus.Approved)
                                                {
                                                    <span class="badge bg-success">Approved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                            </td>
                                            <td>@request.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <form asp-action="ApproveLeaveRequest" method="post" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="requestId" value="@request.Id" />
                                                        <input type="hidden" name="notes" value="" />
                                                        <button type="submit" class="btn btn-sm btn-success" 
                                                                title="Approve" onclick="return confirm('Approve this leave request?')">
                                                            <i class="bi bi-check-circle"></i> Approve
                                                        </button>
                                                    </form>
                                                    <button type="button" class="btn btn-sm btn-danger" 
                                                            title="Reject" data-bs-toggle="modal" 
                                                            data-bs-target="#rejectModal" 
                                                            data-request-id="@request.Id">
                                                        <i class="bi bi-x-circle"></i> Reject
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="card dashboard-card">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-check me-2"></i>
                        Approved Leaves
                        <span class="badge bg-success ms-2">@Model.ApprovedLeaves.Count</span>
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.ApprovedLeaves.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Duration</th>
                                        <th>Leave Type</th>
                                        <th>Notes</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var leave in Model.ApprovedLeaves)
                                    {
                                        <tr>
                                            <td class="fw-bold">#@leave.Id</td>
                                            <td>@leave.StartDate.ToString("yyyy-MM-dd")</td>
                                            <td>@leave.EndDate.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                @{
                                                    var days = (leave.EndDate - leave.StartDate).Days + 1;
                                                }
                                                @days day(s)
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@leave.LeaveType</span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(leave.Notes))
                                                {
                                                    <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@leave.Notes">
                                                        @leave.Notes
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (leave.Status == HCMS4.Models.LeaveStatus.Approved)
                                                {
                                                    <span class="badge bg-success">Approved</span>
                                                }
                                                else if (leave.Status == HCMS4.Models.LeaveStatus.Pending)
                                                {
                                                    <span class="badge bg-warning">Pending</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-calendar-x display-1 text-muted"></i>
                            <h4 class="mt-3">No Leave Records</h4>
                            <p class="text-muted">No approved leaves found for this doctor.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-x-circle me-2"></i>Reject Leave Request
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RejectLeaveRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="requestId" id="modalRequestId" value="" />
                    <div class="mb-3">
                        <label for="reason" class="form-label">
                            Rejection Reason <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="reason" name="reason" rows="4" 
                                  placeholder="Please provide a reason for rejecting this request..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var rejectModal = document.getElementById('rejectModal');
            rejectModal.addEventListener('show.bs.modal', function(event) {
                var button = event.relatedTarget;
                var requestId = button.getAttribute('data-request-id');
                document.getElementById('modalRequestId').value = requestId;
            });
        });
    </script>
}
