@model HCMS4.Models.Patient

@{
    ViewData["Title"] = "Edit Patient";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3">Edit Patient</h1>
                <a asp-action="Patients" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>

            <div class="card dashboard-card mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center mb-4">
                                <div class="avatar-xl me-3">
                                    <div class="avatar-title bg-gradient-success rounded-circle">
                                        <i class="bi bi-person fs-1"></i>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="mb-1">@Model.User?.FullName</h4>
                                    <p class="text-muted mb-0">@Model.User?.Email</p>
                                    <small class="text-muted">Patient ID: @Model.Id</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-end">
                                <div class="mb-2">
                                    <span class="badge bg-gradient-success">Patient</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="card dashboard-card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Patient Information</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditPatient" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />

                        
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="section-title mb-3">
                                    <i class="bi bi-info-circle me-2"></i>Basic Information
                                </h6>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="User!.FirstName" class="form-label">
                                        <i class="bi bi-person me-1"></i>First Name
                                    </label>
                                    <input asp-for="User!.FirstName" class="form-control" />
                                    <span asp-validation-for="User!.FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="User!.LastName" class="form-label">
                                        <i class="bi bi-person me-1"></i>Last Name
                                    </label>
                                    <input asp-for="User!.LastName" class="form-control" />
                                    <span asp-validation-for="User!.LastName" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="User!.Email" class="form-label">
                                        <i class="bi bi-envelope me-1"></i>Email Address
                                    </label>
                                    <input asp-for="User!.Email" class="form-control" type="email" />
                                    <span asp-validation-for="User!.Email" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="User!.PhoneNumber" class="form-label">
                                        <i class="bi bi-telephone me-1"></i>Phone Number
                                    </label>
                                    <input asp-for="User!.PhoneNumber" class="form-control" />
                                    <span asp-validation-for="User!.PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                    
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="section-title mb-3">
                                    <i class="bi bi-heart-pulse me-2"></i>Medical Information
                                </h6>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="DateOfBirth" class="form-label">
                                        <i class="bi bi-calendar me-1"></i>Date of Birth
                                    </label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" 
                                           value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                    <small class="text-muted">Required for medical records</small>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EmergencyContact" class="form-label">
                                        <i class="bi bi-telephone-forward me-1"></i>Emergency Contact
                                    </label>
                                    <input asp-for="EmergencyContact" class="form-control" 
                                           placeholder="+1234567890" />
                                    <span asp-validation-for="EmergencyContact" class="text-danger"></span>
                                    <small class="text-muted">Phone number in case of emergency</small>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="section-title mb-3">
                                    <i class="bi bi-geo-alt me-2"></i>Address Information
                                </h6>
                            </div>
                            
                            <div class="col-12">
                                <div class="mb-3">
                                    <label asp-for="Address" class="form-label">
                                        <i class="bi bi-house me-1"></i>Address
                                    </label>
                                    <textarea asp-for="Address" class="form-control" rows="3" 
                                              placeholder="Enter full address including street, city, and zip code"></textarea>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                    <small class="text-muted">Full residential address</small>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="section-title mb-3">
                                    <i class="bi bi-bar-chart me-2"></i>Patient Statistics
                                </h6>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="card dashboard-card h-100">
                                    <div class="card-body text-center">
                                        <div class="header-icon bg-gradient-info mx-auto mb-3">
                                            <i class="bi bi-calendar-check"></i>
                                        </div>
                                        <h3>@Model.Appointments?.Count</h3>
                                        <p class="text-muted mb-0">Appointments</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="card dashboard-card h-100">
                                    <div class="card-body text-center">
                                        <div class="header-icon bg-gradient-success mx-auto mb-3">
                                            <i class="bi bi-prescription"></i>
                                        </div>
                                        <h3>@Model.Prescriptions?.Count</h3>
                                        <p class="text-muted mb-0">Prescriptions</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="card dashboard-card h-100">
                                    <div class="card-body text-center">
                                        <div class="header-icon bg-gradient-danger mx-auto mb-3">
                                            <i class="bi bi-receipt"></i>
                                        </div>
                                        <h3>@Model.Invoices?.Count</h3>
                                        <p class="text-muted mb-0">Invoices</p>
                                    </div>
                                </div>
                            </div>
                        </div>

               
                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Patients" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle me-1"></i>Save Changes
                                </button>
                                <a asp-action="PatientDetails" asp-route-id="@Model.Id" class="btn btn-outline-info ms-2">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    

    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
   
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function(event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    
                    form.classList.add('was-validated');
                }, false);
            });
            
            
            const phoneInputs = document.querySelectorAll('input[type="tel"], input[name*="Phone"], input[name*="Contact"]');
            phoneInputs.forEach(input => {
                input.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length > 0) {
                        value = '+' + value;
                    }
                    e.target.value = value;
                });
            });
            

            const dobInput = document.querySelector('input[name="DateOfBirth"]');
            if (dobInput) {
                dobInput.addEventListener('change', function() {
                    const selectedDate = new Date(this.value);
                    const today = new Date();
                    
                    if (selectedDate > today) {
                        this.setCustomValidity('Date of birth cannot be in the future');
                        this.reportValidity();
                    } else {
                        this.setCustomValidity('');
                    }
                });
            }
        });
    </script>
}