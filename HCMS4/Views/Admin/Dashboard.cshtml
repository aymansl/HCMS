@using HCMS4.ViewModels
@model dynamic
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_LayoutAuth";
    var todayReport = ViewBag.TodayReport as DailyPharmacyReportViewModel;
}
  <div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2">Admin Dashboard</h1>
            <p class="text-muted">Welcome, @User.Identity?.Name</p>
        </div>
    </div>
    
<div class="row">
  <div class="col-md-4 stretch-card grid-margin">
    <div class="card bg-gradient-danger card-img-holder text-white">
      <div class="card-body">
        <img src="~/assets/img/circle.svg" class="card-img-absolute" alt="circle-image">
        <h4 class="font-weight-normal mb-3">Patients <i class="mdi mdi-chart-line mdi-24px float-end"></i></h4>
        <h2 class="mb-5">@ViewBag.PatientCount</h2>
      </div>
    </div>
  </div>
  <div class="col-md-4 stretch-card grid-margin">
    <div class="card bg-gradient-info card-img-holder text-white">
      <div class="card-body">
        <img src="~/assets/img/circle.svg" class="card-img-absolute" alt="circle-image">
        <h4 class="font-weight-normal mb-3">Doctors <i class="mdi mdi-bookmark-outline mdi-24px float-end"></i></h4>
        <h2 class="mb-5">@ViewBag.DoctorCount</h2>
      </div>
    </div>
  </div>
  <div class="col-md-4 stretch-card grid-margin">
    <div class="card bg-gradient-success card-img-holder text-white">
      <div class="card-body">
        <img src="~/assets/img/circle.svg" class="card-img-absolute" alt="circle-image">
        <h4 class="font-weight-normal mb-3">Appointments <i class="mdi mdi-diamond mdi-24px float-end"></i></h4>
        <h2 class="mb-5">@ViewBag.AppointmentCount</h2>
      </div>
    </div>
  </div>
  
</div>

<!-- Quick Links Section -->
<div class="row mt-4">
    <div class="col-12">
        <h5 class="mb-3">Management Tools</h5>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card dashboard-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-people display-4 text-primary mb-3"></i>
                <h6 class="card-title">Manage Suppliers</h6>
                <p class="text-muted small mb-3">Add, edit, or remove suppliers</p>
                <a asp-action="Suppliers" class="btn btn-sm btn-primary">
                    <i class="bi bi-arrow-right"></i> Go to Suppliers
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card dashboard-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-cash-coin display-4 text-success mb-3"></i>
                <h6 class="card-title">Price List</h6>
                <p class="text-muted small mb-3">Manage consultation fees</p>
                <a asp-action="PriceList" class="btn btn-sm btn-success">
                    <i class="bi bi-arrow-right"></i> Go to Price List
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card dashboard-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-receipt display-4 text-warning mb-3"></i>
                <h6 class="card-title">Daily Report</h6>
                <p class="text-muted small mb-3">View pharmacy reports</p>
                <a asp-action="DailyPharmacyReport" class="btn btn-sm btn-warning">
                    <i class="bi bi-arrow-right"></i> View Report
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card dashboard-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-cart-check display-4 text-danger mb-3"></i>
                <h6 class="card-title">Purchase Approvals</h6>
                <p class="text-muted small mb-3">Review pharmacist requests</p>
                <a asp-action="PurchaseRequests" class="btn btn-sm btn-danger">
                    <i class="bi bi-arrow-right"></i> View Requests
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card dashboard-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-chat-left-text display-4 text-secondary mb-3"></i>
                <h6 class="card-title">Complaints</h6>
                <p class="text-muted small mb-2">@ViewBag.PendingComplaintsCount pending for review</p>
                <a asp-action="Complaints" class="btn btn-sm btn-secondary">
                    <i class="bi bi-arrow-right"></i> Review Complaints
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card dashboard-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-clipboard-check display-4 text-success mb-3"></i>
                <h6 class="card-title">Surveys</h6>
                <p class="text-muted small mb-2">@ViewBag.ActiveSurveysCount active survey(s)</p>
                <a asp-action="Surveys" class="btn btn-sm btn-success">
                    <i class="bi bi-arrow-right"></i> Manage Surveys
                </a>
            </div>
        </div>
            
        </div>
</div>

<!-- Daily Pharmacy Report Section -->
<div class="card dashboard-card mt-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-receipt me-2 text-primary"></i>
            Daily Pharmacy Invoice Report
        </h5>
        <a asp-action="DailyPharmacyReport" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-eye"></i> View Full Report
        </a>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="info-box p-3 bg-light rounded">
                    <small class="text-muted text-uppercase">Today's Date</small>
                    <h5 class="mb-0">@DateTime.Today.ToString("dd MMMM yyyy")</h5>
                </div>
            </div>
            <div class="col-md-3">
                <div class="info-box p-3 bg-light rounded">
                    <small class="text-muted text-uppercase">Total Invoices</small>
                    <h3 class="mb-0 text-primary">@todayReport.TotalInvoices</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="info-box p-3 bg-light rounded">
                    <small class="text-muted text-uppercase">Total Amount</small>
                    <h3 class="mb-0 text-success">@todayReport.TotalAmount.ToString("C2")</h3>
                </div>
            </div>
        </div>

        @if (todayReport.HasInvoices)
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Invoice #</th>
                            <th>Patient</th>
                            <th>Pharmacist</th>
                            <th>Amount</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in todayReport.Invoices.Take(5))
                        {
                            <tr>
                                <td>#@invoice.InvoiceId</td>
                                <td>@invoice.PatientName</td>
                                <td>@invoice.PharmacistName</td>
                                <td>@invoice.TotalAmount.ToString("C2")</td>
                                <td>@invoice.InvoiceTime.ToString("HH:mm")</td>
                                <td>
                                    @if (invoice.PaymentStatus == PaymentStatus.Paid)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (todayReport.Invoices.Count > 5)
                {
                    <div class="text-center mt-2">
                        <small class="text-muted">+ @(todayReport.Invoices.Count - 5) more invoices</small>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info text-center mb-0">
                <i class="bi bi-info-circle me-2"></i>
                No pharmacy invoices have been issued today.
            </div>
        }
    </div>
</div>
