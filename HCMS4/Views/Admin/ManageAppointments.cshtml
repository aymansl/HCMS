@model HCMS4.ViewModels.ManageAppointmentsViewModel

@{
    ViewData["Title"] = "Manage Appointments";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3">Manage Appointments</h1>
                <a asp-action="BookAppointment" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Book New Appointment
                </a>
            </div>


            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!Model.AnalyticsServiceAvailable)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Analytics service currently unavailable
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.AnalyticsServiceAvailable)
            {
                <div class="alert alert-info alert-dismissible fade show d-flex align-items-center" role="alert">
                    @if (Model.IsUsingAI)
                    {
                        <i class="bi bi-robot me-2"></i>
                        <span><strong>AI Mode Active:</strong> No-show predictions are being calculated using the AI model.</span>
                    }
                    else
                    {
                        <i class="bi bi-cpu me-2"></i>
                        <span><strong>Rule-Based Mode:</strong> No-show predictions are being calculated using local rules (AI API not connected).</span>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }


            @if (Model.SelectedStatus == "all")
            {
                <div class="row mb-4">
                    <div class="col-md-3 col-sm-6">
                        <div class="card dashboard-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-2">Today's Appointments</h6>
                                        <h3 class="mb-0">@Model.TodayAppointments.Count</h3>
                                    </div>
                                    <div class="header-icon bg-gradient-info">
                                        <i class="bi bi-calendar-day"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="card dashboard-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-2">Scheduled</h6>
                                        <h3 class="mb-0">@(Model.TodayAppointments.Count(a => a.Status == AppointmentStatus.Scheduled) + Model.UpcomingAppointments.Count(a => a.Status == AppointmentStatus.Scheduled))</h3>
                                    </div>
                                    <div class="header-icon bg-gradient-success">
                                        <i class="bi bi-calendar-check"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="card dashboard-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-2">Completed</h6>
                                        <h3 class="mb-0">@(Model.TodayAppointments.Count(a => a.Status == AppointmentStatus.Completed) + Model.UpcomingAppointments.Count(a => a.Status == AppointmentStatus.Completed))</h3>
                                    </div>
                                    <div class="header-icon bg-gradient-warning">
                                        <i class="bi bi-check-circle"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="card dashboard-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-2">Canceled</h6>
                                        <h3 class="mb-0">@(Model.TodayAppointments.Count(a => a.Status == AppointmentStatus.Canceled) + Model.CanceledAppointments.Count)</h3>
                                    </div>
                                    <div class="header-icon bg-gradient-danger">
                                        <i class="bi bi-x-circle"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }


            <div class="card dashboard-card mb-4">
                <div class="card-body">
                    <form method="get" class="row g-3 align-items-end mb-3">
                        <input type="hidden" name="status" value="@Model.SelectedStatus" />
                        <div class="col-md-4">
                            <label class="form-label">Risk Filter</label>
                            <select name="riskLevel" class="form-select">
                                <option value="all" selected="@(Model.SelectedRiskLevel == "all")">All Risk Levels</option>
                                <option value="high" selected="@(Model.SelectedRiskLevel == "high")">High Risk</option>
                                <option value="medium" selected="@(Model.SelectedRiskLevel == "medium")">Medium Risk</option>
                                <option value="low" selected="@(Model.SelectedRiskLevel == "low")">Low Risk</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-funnel me-1"></i>Apply Filter
                            </button>
                        </div>
                    </form>
                    <ul class="nav nav-tabs nav-tabs-bordered" id="appointmentTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link @(Model.SelectedStatus == "all" ? "active" : "")"
                               asp-action="ManageAppointments" asp-route-status="all" asp-route-riskLevel="@Model.SelectedRiskLevel">
                                <i class="bi bi-list me-1"></i>All Appointments
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link @(Model.SelectedStatus == "Scheduled" ? "active" : "")"
                               asp-action="ManageAppointments" asp-route-status="Scheduled" asp-route-riskLevel="@Model.SelectedRiskLevel">
                                <i class="bi bi-clock me-1"></i>Scheduled
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link @(Model.SelectedStatus == "Completed" ? "active" : "")"
                               asp-action="ManageAppointments" asp-route-status="Completed" asp-route-riskLevel="@Model.SelectedRiskLevel">
                                <i class="bi bi-check-circle me-1"></i>Completed
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link @(Model.SelectedStatus == "Canceled" ? "active" : "")"
                               asp-action="ManageAppointments" asp-route-status="Canceled" asp-route-riskLevel="@Model.SelectedRiskLevel">
                                <i class="bi bi-x-circle me-1"></i>Canceled
                            </a>
                        </li>
                    </ul>
                </div>
            </div>


            @if (Model.SelectedStatus == "all")
            {

                <div class="card dashboard-card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-calendar-day me-2"></i>Today's Appointments
                            <span class="badge bg-info ms-2">@Model.TodayAppointments.Count</span>
                        </h5>
                        <span class="text-muted">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</span>
                    </div>
                    <div class="card-body">
                        @if (Model.TodayAppointments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Risk</th>
                                            <th>Time</th>
                                            <th>Patient</th>
                                            <th>Doctor</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in Model.TodayAppointments.OrderBy(a => a.AppointmentDateTime))
                                        {
                                            var riskScore = Model.AppointmentRiskScores.ContainsKey(appointment.Id) ? Model.AppointmentRiskScores[appointment.Id] : 0.0;
                                            var riskClass = riskScore > 0.7 ? "bg-danger" : (riskScore > 0.4 ? "bg-warning" : "bg-success");
                                            var riskColor = riskScore > 0.7 ? "#dc3545" : (riskScore > 0.4 ? "#ffc107" : "#198754");
                                            var riskLevel = riskScore > 0.7 ? "High Risk" : (riskScore > 0.4 ? "Medium Risk" : "Low Risk");
                                            <tr>
                                                <td>
                                                    @if (Model.AnalyticsServiceAvailable)
                                                    {
                                                        <div class="risk-indicator" data-bs-toggle="tooltip" title="@riskLevel (@(riskScore * 100)% chance)">
                                                            <span class="badge @riskClass rounded-circle" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 10px; color: white;">
                                                                <i class="bi bi-exclamation" style="font-size: 12px;"></i>
                                                            </span>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    <strong>@appointment.AppointmentDateTime.ToString("hh:mm tt")</strong>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong>@appointment.Patient?.User?.FullName</strong>
                                                            <div class="text-muted small">@appointment.Patient?.User?.Email</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong>Dr. @appointment.Doctor?.User?.FullName</strong>
                                                            <div class="text-muted small">@appointment.Doctor?.Specialization</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    @await Html.PartialAsync("_AppointmentStatusBadge", appointment.Status)
                                                </td>
                                                <td>
                                                    <div class="btn-group-uniform">
                                                        @if (appointment.Status == AppointmentStatus.Scheduled)
                                                        {
                                                            @* Only show reminder for high-risk appointments *@
                                                            if (riskScore > 0.7)
                                                            {
                                                                <form asp-action="SendReminder" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@appointment.Id" />
                                                                    <button type="submit" class="btn btn-gradient-info btn-icon" title="Send Reminder">
                                                                        <i class="bi bi-bell"></i>
                                                                    </button>
                                                                </form>
                                                            }
                                                            <a asp-action="RescheduleAppointment" asp-route-id="@appointment.Id"
                                                               class="btn btn-gradient-warning btn-icon" title="Reschedule">
                                                                <i class="bi bi-calendar-week"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-gradient-danger btn-icon cancel-btn"
                                                                    title="Cancel Appointment"
                                                                    data-appointment-id="@appointment.Id"
                                                                    data-patient-name="@appointment.Patient?.User?.FullName">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-calendar-x display-1 text-muted"></i>
                                <h4 class="mt-3">No Appointments Today</h4>
                                <p class="text-muted">No appointments are scheduled for today.</p>
                            </div>
                        }
                    </div>
                </div>


                <div class="card dashboard-card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-calendar-week me-2"></i>Upcoming Appointments
                            <span class="badge bg-info ms-2">@Model.UpcomingAppointments.Count</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.UpcomingAppointments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Risk</th>
                                            <th>Date & Time</th>
                                            <th>Patient</th>
                                            <th>Doctor</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in Model.UpcomingAppointments.OrderBy(a => a.AppointmentDateTime))
                                        {
                                            var riskScore = Model.AppointmentRiskScores.ContainsKey(appointment.Id) ? Model.AppointmentRiskScores[appointment.Id] : 0.0;
                                            var riskClass = riskScore > 0.7 ? "bg-danger" : (riskScore > 0.4 ? "bg-warning" : "bg-success");
                                            var riskLevel = riskScore > 0.7 ? "High Risk" : (riskScore > 0.4 ? "Medium Risk" : "Low Risk");
                                            <tr>
                                                <td>
                                                    @if (Model.AnalyticsServiceAvailable)
                                                    {
                                                        <div class="risk-indicator" data-bs-toggle="tooltip" title="@riskLevel (@(riskScore * 100)% chance)">
                                                            <span class="badge @riskClass rounded-circle" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 10px; color: white;">
                                                                <i class="bi bi-exclamation" style="font-size: 12px;"></i>
                                                            </span>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    <strong>@appointment.AppointmentDateTime.ToString("MMM dd")</strong>
                                                    <div class="text-muted small">@appointment.AppointmentDateTime.ToString("hh:mm tt")</div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong>@appointment.Patient?.User?.FullName</strong>
                                                            <div class="text-muted small">@appointment.Patient?.User?.Email</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong>Dr. @appointment.Doctor?.User?.FullName</strong>
                                                            <div class="text-muted small">@appointment.Doctor?.Specialization</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-clock me-1"></i>Scheduled
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group-uniform">
                                                        @* Only show reminder for high-risk appointments *@
                                                        @if (riskScore > 0.7)
                                                        {
                                                            <form asp-action="SendReminder" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                                <button type="submit" class="btn btn-gradient-info btn-icon" title="Send Reminder">
                                                                    <i class="bi bi-bell"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                        <a asp-action="RescheduleAppointment" asp-route-id="@appointment.Id"
                                                           class="btn btn-gradient-warning btn-icon" title="Reschedule">
                                                            <i class="bi bi-calendar-week"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-gradient-danger btn-icon cancel-btn"
                                                                title="Cancel Appointment"
                                                                data-appointment-id="@appointment.Id"
                                                                data-patient-name="@appointment.Patient?.User?.FullName">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-calendar-week display-1 text-muted"></i>
                                <h4 class="mt-3">No Upcoming Appointments</h4>
                                <p class="text-muted">No upcoming appointments found.</p>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {

                <div class="card dashboard-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-filter me-2"></i>@Model.SelectedStatus Appointments
                            <span class="badge bg-info ms-2">@Model.FilteredAppointments.Count</span>
                        </h5>
                        <div>
                            <span class="text-muted">Showing all @Model.SelectedStatus.ToLower() appointments</span>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.FilteredAppointments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Risk</th>
                                            <th>Date & Time</th>
                                            <th>Patient</th>
                                            <th>Doctor</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in Model.FilteredAppointments)
                                        {
                                            var riskScore = Model.AppointmentRiskScores.ContainsKey(appointment.Id) ? Model.AppointmentRiskScores[appointment.Id] : 0.0;
                                            var riskClass = riskScore > 0.7 ? "bg-danger" : (riskScore > 0.4 ? "bg-warning" : "bg-success");
                                            var riskLevel = riskScore > 0.7 ? "High Risk" : (riskScore > 0.4 ? "Medium Risk" : "Low Risk");
                                            <tr>
                                                <td>
                                                    @if (Model.AnalyticsServiceAvailable)
                                                    {
                                                        <div class="risk-indicator" data-bs-toggle="tooltip" title="@riskLevel (@(riskScore * 100)% chance)">
                                                            <span class="badge @riskClass rounded-circle" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 10px; color: white;">
                                                                <i class="bi bi-exclamation" style="font-size: 12px;"></i>
                                                            </span>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    <strong>@appointment.AppointmentDateTime.ToString("MMM dd, yyyy")</strong>
                                                    <div class="text-muted small">@appointment.AppointmentDateTime.ToString("hh:mm tt")</div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong>@appointment.Patient?.User?.FullName</strong>
                                                            <div class="text-muted small">@appointment.Patient?.User?.Email</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong>Dr. @appointment.Doctor?.User?.FullName</strong>
                                                            <div class="text-muted small">@appointment.Doctor?.Specialization</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    @await Html.PartialAsync("_AppointmentStatusBadge", appointment.Status)
                                                </td>
                                                <td>
                                                    @if (appointment.Status == AppointmentStatus.Scheduled)
                                                    {
                                                        <div class="btn-group-uniform">
                                                            @* Only show reminder for high-risk appointments *@
                                                            @if (riskScore > 0.7)
                                                            {
                                                                <form asp-action="SendReminder" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@appointment.Id" />
                                                                    <button type="submit" class="btn btn-gradient-info btn-icon" title="Send Reminder">
                                                                        <i class="bi bi-bell"></i>
                                                                    </button>
                                                                </form>
                                                            }
                                                            <a asp-action="RescheduleAppointment" asp-route-id="@appointment.Id"
                                                               class="btn btn-gradient-warning btn-icon" title="Reschedule">
                                                                <i class="bi bi-calendar-week"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-gradient-danger btn-icon cancel-btn"
                                                                    title="Cancel Appointment"
                                                                    data-appointment-id="@appointment.Id"
                                                                    data-patient-name="@appointment.Patient?.User?.FullName">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                    else if (appointment.Status == AppointmentStatus.Canceled && !string.IsNullOrEmpty(appointment.CancellationReason))
                                                    {
                                                        <button type="button" class="btn btn-gradient-info btn-icon view-reason-btn"
                                                                title="View Cancellation Reason"
                                                                data-reason="@appointment.CancellationReason">
                                                            <i class="bi bi-info-circle"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-calendar-x display-1 text-muted"></i>
                                <h4 class="mt-3">No @Model.SelectedStatus Appointments</h4>
                                <p class="text-muted">No @Model.SelectedStatus.ToLower() appointments found.</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Cancel Appointment Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancel Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="cancelForm" asp-action="CancelAppointment" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="id" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="cancellationReason" class="form-label">Cancellation Reason</label>
                        <textarea class="form-control" id="cancellationReason" name="cancellationReason"
                                  rows="3" placeholder="Please provide a reason for cancellation..." required></textarea>
                        <div class="invalid-feedback">Please provide a cancellation reason.</div>
                    </div>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Note:</strong> Appointments cannot be canceled less than 24 hours before the scheduled time.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Cancel Appointment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Cancellation Reason Modal -->
<div class="modal fade" id="reasonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancellation Reason</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    <p id="reasonText" class="mb-0"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            document.querySelectorAll('.cancel-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const appointmentId = this.getAttribute('data-appointment-id');
                    const patientName = this.getAttribute('data-patient-name');


                    Swal.fire({
                        title: 'Cancel Appointment?',
                        html: `Are you sure you want to cancel appointment for <strong>${patientName}</strong>?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#fe7096',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, Cancel',
                        cancelButtonText: 'No, Keep'
                    }).then((result) => {
                        if (result.isConfirmed) {

                            document.getElementById('id').value = appointmentId;

                            document.getElementById('cancellationReason').value = '';
                            const modal = new bootstrap.Modal(document.getElementById('cancelModal'));
                            modal.show();
                        }
                    });
                });
            });


            document.querySelectorAll('.view-reason-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const reason = this.getAttribute('data-reason');
                    document.getElementById('reasonText').textContent = reason;
                    const modal = new bootstrap.Modal(document.getElementById('reasonModal'));
                    modal.show();
                });
            });


            document.getElementById('cancelForm').addEventListener('submit', function(e) {
                const reasonField = document.getElementById('cancellationReason');

                if (!reasonField.value.trim()) {
                    e.preventDefault();
                    reasonField.classList.add('is-invalid');
                    reasonField.focus();
                    return;
                }

                reasonField.classList.remove('is-invalid');


                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Canceling...';
                submitBtn.disabled = true;


            });


            const cancellationReasonField = document.getElementById('cancellationReason');
            if (cancellationReasonField) {
                cancellationReasonField.addEventListener('input', function() {
                    if (this.value.trim().length > 0) {
                        this.classList.remove('is-invalid');
                    }
                });
            }
        });
    </script>
}
