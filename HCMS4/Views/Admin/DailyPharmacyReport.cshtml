<!-- Views/Admin/DailyPharmacyReport.cshtml -->
@model HCMS4.ViewModels.DailyPharmacyReportViewModel

@{
    ViewData["Title"] = "Daily Pharmacy Invoice Report";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3">
                        <i class="bi bi-receipt me-2 text-primary"></i>
                        Daily Pharmacy Invoice Report
                    </h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item active">Pharmacy Report</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <a asp-action="ExportPharmacyReport" asp-route-date="@Model.ReportDate" class="btn btn-success me-2">
                        <i class="bi bi-download"></i> Export CSV
                    </a>
                    <a asp-action="Dashboard" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Date Filter Card -->
            <div class="card dashboard-card mb-4">
                <div class="card-body">
                    <form asp-action="FilteredPharmacyReport" method="get" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Start Date</label>
                            <input type="date" name="StartDate" class="form-control" value="@ViewBag.Filters?.StartDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">End Date</label>
                            <input type="date" name="EndDate" class="form-control" value="@ViewBag.Filters?.EndDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Payment Status</label>
                            <select name="PaymentStatus" class="form-select">
                                <option value="">All</option>
                                <option value="0" selected="@(ViewBag.Filters?.PaymentStatus == HCMS4.Models.PaymentStatus.Pending)">Pending</option>
                                <option value="1" selected="@(ViewBag.Filters?.PaymentStatus == HCMS4.Models.PaymentStatus.Paid)">Paid</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input type="text" name="SearchTerm" class="form-control" placeholder="Patient name, invoice #..." value="@ViewBag.Filters?.SearchTerm" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search"></i> Filter
                            </button>
                        </div>
                    </form>

                    <hr />

                    <div class="row">
                        <div class="col-md-4">
                            <a asp-action="DailyPharmacyReport" class="btn btn-outline-secondary btn-sm me-2">
                                <i class="bi bi-calendar-today"></i> Today
                            </a>
                            @if (ViewBag.AvailableDates != null)
                            {
                                <select id="dateSelect" class="form-select form-select-sm d-inline-block w-auto" onchange="window.location.href='/Admin/DailyPharmacyReport?date=' + this.value">
                                    <option value="">Previous Dates</option>
                                    @foreach (var date in (List<DateTime>)ViewBag.AvailableDates)
                                    {
                                        <option value="@date.ToString("yyyy-MM-dd")">@date.ToString("dd MMM yyyy")</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Report Summary Cards -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card dashboard-card bg-primary text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-white-50 mb-1">Report Date</h6>
                                    <h4 class="mb-0">@Model.ReportDate.ToString("dd MMM yyyy")</h4>
                                </div>
                                <i class="bi bi-calendar-date fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card dashboard-card bg-success text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-white-50 mb-1">Total Invoices</h6>
                                    <h4 class="mb-0">@Model.TotalInvoices</h4>
                                </div>
                                <i class="bi bi-receipt fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card dashboard-card bg-info text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-white-50 mb-1">Total Amount</h6>
                                    <h4 class="mb-0">@Model.TotalAmount.ToString("C2")</h4>
                                </div>
                                <i class="bi bi-cash-stack fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Invoices Table -->
            <div class="card dashboard-card">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-table me-2"></i>
                        Pharmacy Invoices
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.HasInvoices && Model.Invoices.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Invoice #</th>
                                        <th>Patient Name</th>
                                        <th>Pharmacist</th>
                                        <th>Total Amount</th>
                                        <th>Time</th>
                                        <th>Payment Status</th>
                                        <th>Prescription</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in Model.Invoices)
                                    {
                                        <tr>
                                            <td class="fw-bold">#@invoice.InvoiceId</td>
                                            <td>@invoice.PatientName</td>
                                            <td>@invoice.PharmacistName</td>
                                            <td class="fw-bold text-success">@invoice.TotalAmount.ToString("C2")</td>
                                            <td>@invoice.InvoiceTime.ToString("HH:mm")</td>
                                            <td>
                                                @if (invoice.PaymentStatus == PaymentStatus.Paid)
                                                {
                                                    <span class="badge bg-success">Paid</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Pending</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(invoice.PrescriptionId))
                                                {
                                                    <span class="badge bg-info">RX-@invoice.PrescriptionId</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="InvoiceDetails" asp-route-id="@invoice.InvoiceId"
                                                   class="btn btn-sm btn-info" title="View Invoice">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold">Grand Total:</td>
                                        <td colspan="4" class="fw-bold fs-5 text-success">@Model.TotalAmount.ToString("C2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Pagination placeholder if needed -->
                        @if (Model.Invoices.Count > 20)
                        {
                            <nav>
                                <ul class="pagination justify-content-center">
                                    <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                                    <li class="page-item"><a class="page-link" href="#">Next</a></li>
                                </ul>
                            </nav>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-receipt display-1 text-muted"></i>
                            <h4 class="mt-3">No Invoices Found</h4>
                            <p class="text-muted">
                                @if (ViewBag.Filters != null)
                                {
                                    <text>No invoices match the selected filters.</text>
                                }
                                else
                                {
                                    <text>No pharmacy invoices have been issued for @Model.ReportDate.ToString("dd MMMM yyyy").</text>
                                }
                            </p>
                            <a asp-action="DailyPharmacyReport" class="btn btn-primary">
                                <i class="bi bi-calendar-today"></i> View Today's Report
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Additional Statistics -->
            @if (Model.HasInvoices)
            {
                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card dashboard-card">
                            <div class="card-header bg-white">
                                <h6 class="mb-0">
                                    <i class="bi bi-pie-chart me-2"></i>
                                    Payment Status Distribution
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-6">
                                        <div class="p-3">
                                            <h3 class="text-warning mb-0">@Model.Invoices.Count(i => i.PaymentStatus == PaymentStatus.Pending)</h3>
                                            <small class="text-muted">Pending</small>
                                            <div class="progress mt-2" style="height: 8px;">
                                                <div class="progress-bar bg-warning" style="width: @(Model.Invoices.Count(i => i.PaymentStatus == PaymentStatus.Pending) * 100 / Model.TotalInvoices)%"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3">
                                            <h3 class="text-success mb-0">@Model.Invoices.Count(i => i.PaymentStatus == PaymentStatus.Paid)</h3>
                                            <small class="text-muted">Paid</small>
                                            <div class="progress mt-2" style="height: 8px;">
                                                <div class="progress-bar bg-success" style="width: @(Model.Invoices.Count(i => i.PaymentStatus == PaymentStatus.Paid) * 100 / Model.TotalInvoices)%"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh the report every 5 minutes (optional)
        @if (Model.ReportDate.Date == DateTime.Today)
        {
                <text>
                setTimeout(function() {
                    location.reload();
                }, 300000); // Refresh every 5 minutes
                </text>
        }

        // Format currency function
        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD'
            }).format(amount);
        }

        // Print report function
        function printReport() {
            window.print();
        }
    </script>
}

<style>
    @@media print {
        .btn, .breadcrumb, .navbar, .footer {
            display: none !important;
        }

        .card {
            border: 1px solid #ddd !important;
            break-inside: avoid;
        }

        .table {
            font-size: 12px;
        }
    }

    .dashboard-card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
        transition: transform 0.2s;
    }

        .dashboard-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
        }

    .bg-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }

    .bg-success {
        background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%) !important;
    }

    .bg-info {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%) !important;
        color: #333 !important;
    }

    .text-white-50 {
        color: rgba(255,255,255,0.7) !important;
    }

    .progress {
        background-color: #e9ecef;
        border-radius: 10px;
    }
</style>