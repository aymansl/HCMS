@using HCMS4.Controllers;
@using HCMS4.Models
@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - Medilab Dashboard</title>

    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    @{
        var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    }

    <script>
        // Set anti-forgery token for AJAX requests
        window.antiForgeryToken = '@requestToken';
    </script>

  <!-- Same CSS files as before -->
  <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="~/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
  <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
  <link href="~/assets/css/main.css" rel="stylesheet">

  <link href="~/assets/css/admintemp.css" rel="stylesheet">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</head>

<body class="dashboard-body">


<header id="header" class="header fixed-top">
    <div class="container-fluid px-4">
        <nav class="navbar navbar-expand-lg px-0">
            
        
            <a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center">
                <div class="logo-icon bg-gradient-danger rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                    <i class="bi bi-heart-pulse text-white"></i>
                </div>
                <span class="sitename fs-4 fw-bold gradient-text-danger">Medilab</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <i class="bi bi-list fs-3"></i>
            </button>

         
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    
                    
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="Dashboard" class="nav-link admin-link">
                                <i class="bi bi-grid me-1"></i> Admin Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="CreateDoctor" class="nav-link admin-link">
                                <i class="bi bi-person-plus me-1"></i> Create Doctor Account
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="Doctors" class="nav-link admin-link">
                                <i class="bi bi-people me-1"></i> Doctors
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="Patients" class="nav-link admin-link">
                                <i class="bi bi-person-vcard me-1"></i> Patients
                            </a>
                        </li>
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="Pharmacists" class="nav-link admin-link">
                                    <i class="bi bi-person-badge me-1"></i> Pharmacists
                                </a>
                            </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="ManageAppointments" class="nav-link admin-link">
                                <i class="bi bi-calendar2-check me-1"></i> Manage Appointements
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="Complaints" class="nav-link admin-link">
                                <i class="bi bi-chat-left-text me-1"></i> Complaints
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="Surveys" class="nav-link admin-link">
                                <i class="bi bi-clipboard-check me-1"></i> Surveys
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="PendingPrescriptions" class="nav-link admin-link">
                                <i class="bi bi-prescription me-2"></i>Pending Prescriptions
                               
                            </a>
                        </li>              
                    }

                        @if (User.IsInRole("Pharmacist"))
                        {
                            <li class="nav-item">
                                <a asp-controller="Pharmacist" asp-action="Dashboard" class="nav-link pharmacist-link">
                                    <i class="bi bi-grid me-1"></i> Pharmacist Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Pharmacist" asp-action="Drugs" class="nav-link pharmacist-link">
                                    <i class="bi bi-capsule me-1"></i> Manage Drugs
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Pharmacist" asp-action="Prescriptions" class="nav-link pharmacist-link">
                                    <i class="bi bi-prescription me-1"></i> Prescriptions
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Pharmacist" asp-action="PurchaseRequests" class="nav-link pharmacist-link">
                                    <i class="bi bi-cash-stack me-1"></i> Purchase Requests
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="Profile" class="nav-link pharmacist-link">
                                    <i class="bi bi-person-circle me-1"></i> Profile
                                </a>
                            </li>
                            
                        }
                    
                    @if (User.IsInRole("Doctor"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Doctor" asp-action="Dashboard" class="nav-link doctor-link">
                                <i class="bi bi-calendar-check me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Doctor" asp-action="ViewAppointments" class="nav-link doctor-link">
                                <i class="bi bi-calendar-check me-1"></i> Appointments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Doctor" asp-action="ReissueRequests" class="nav-link doctor-link">
                                <i class="bi bi-arrow-repeat me-1"></i> Re-issuance
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Doctor" asp-action="DoctorReviewRequests" class="nav-link doctor-link">
                                <i class="bi bi-capsule-pill me-1"></i> Review Requests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Doctor" asp-action="MedicalArticles" class="nav-link doctor-link">
                                <i class="bi bi-journal-medical me-1"></i> Articles
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="DailyVisitingPatientsReport" class="nav-link doctor-link">
                                <i class="bi bi-file-text me-1"></i> Reports
                            </a>
                        </li>
                        <li class="nav-item">
                                <a asp-controller="Doctor" asp-action="Profile" class="nav-link doctor-link">
                                <i class="bi bi-person-circle me-1"></i> Profile
                            </a>
                        </li>
                    }
                    
                    
                    @if (User.IsInRole("Patient"))
                    {
                        
                        <li class="nav-item">
                            <a asp-controller="Patient" asp-action="Dashboard" class="nav-link patient-link">
                                <i class="bi bi-calendar me-1"></i> DashBoard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Patient" asp-action="BookAppointment" class="nav-link patient-link">
                                <i class="bi bi-calendar me-1"></i> Book Appointment
                            </a>
                        </li>
                         <li class="nav-item">
                            <a asp-controller="Patient" asp-action="ViewAppointmentHistory" class="nav-link patient-link">
                                <i class="bi bi-file-medical me-1"></i> Appointment History
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Patient" asp-action="InvoiceHistory" class="nav-link patient-link">
                                <i class="bi bi-receipt me-1"></i>My invoices
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Patient" asp-action="Prescriptions" class="nav-link patient-link">
                                <i class="bi bi-receipt me-1"></i>My Prescriptions
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Patient" asp-action="Complaints" class="nav-link patient-link">
                                <i class="bi bi-chat-left-text me-1"></i>Complaints
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Patient" asp-action="Surveys" class="nav-link patient-link">
                                <i class="bi bi-clipboard-check me-1"></i>Surveys
                            </a>
                        </li>
                                                
                       <li class="nav-item">
                            <a asp-controller="Account" asp-action="Profile" class="nav-link patient-link">
                                <i class="bi bi-person-circle me-1"></i> Profile
                            </a>
                        </li>
                        
                    }
                </ul>

                
                <div class="user-dropdown d-flex align-items-center">
                   
                    <a asp-controller="Patient" asp-action="Dashboard" class="nav-link me-3 position-relative">
                        <i class="bi bi-bell fs-5"></i>
                    </a>
                    
                    <div class="dropdown">
                        <button class="btn btn-gradient-user d-flex align-items-center px-3 py-2" type="button" 
                                data-bs-toggle="dropdown">
                            <div class="avatar me-2">
                                <i class="bi bi-person-circle fs-4"></i>
                            </div>
                            <div class="user-info text-start">
                                <div class="fw-medium">@User.Identity?.Name</div>
                                <small>
                                    @if (User.IsInRole("Admin")) { 
                                        <span class="badge bg-danger">Admin</span> 
                                    }
                                    @if (User.IsInRole("Doctor")) { 
                                        <span class="badge bg-info">Doctor</span> 
                                    }
                                    @if (User.IsInRole("Patient")) { 
                                        <span class="badge bg-success">Patient</span> 
                                    }
                                </small>
                            </div>
                            <i class="bi bi-chevron-down ms-2"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger w-100">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </div>
</header>






  <main id="main" class="main">
    <div class="container-fluid">
      @RenderBody()
    </div>
  </main>

  <footer id="footer" class="footer mt-auto">
    <div class="container">
      <div class="copyright">
        &copy; @DateTime.Now.Year <strong>Medilab Dashboard</strong>. All Rights Reserved
      </div>
    </div>
  </footer>


  <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="~/assets/vendor/aos/aos.js"></script>
  <script src="~/assets/js/main.js"></script>
  
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

