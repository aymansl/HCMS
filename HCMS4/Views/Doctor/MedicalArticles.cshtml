@model List<HCMS4.Models.MedicalArticle>

@{
    ViewData["Title"] = "Medical Articles";
    Layout = "_LayoutAuth";
    var canPublish = (bool)(ViewBag.CanPublishArticles ?? false);
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Medical Articles</h1>
        @if (canPublish)
        {
            <a asp-action="CreateMedicalArticle" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>New Article
            </a>
        }
    </div>

    @if (!canPublish)
    {
        <div class="alert alert-warning">You do not have permission to publish articles.</div>
    }

    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Published</th>
                                <th>Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var article in Model)
                            {
                                var isPublished = article.Status == HCMS4.Models.ArticleStatus.Published;
                                <tr>
                                    <td>@article.Title</td>
                                    <td>@article.Category</td>
                                    <td>
                                        <span class="badge @(isPublished ? "bg-success" : "bg-warning text-dark")">
                                            @article.Status
                                        </span>
                                    </td>
                                    <td>@(article.PublishedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>@article.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @if (!isPublished)
                                        {
                                            <form asp-action="PublishMedicalArticle" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@article.Id" />
                                                <button type="submit" class="btn btn-sm btn-success"
                                                        onclick="return confirm('Publish this draft article now?')">
                                                    <i class="bi bi-send-check"></i> Publish
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-success small fw-semibold">
                                                <i class="bi bi-check-circle me-1"></i>Live
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No articles created yet.</p>
            }
        </div>
    </div>
</div>
