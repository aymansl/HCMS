@model List<HCMS4.Models.PrescriptionReissueRequest>

@{
    ViewData["Title"] = "Re-issuance Requests";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <h1 class="h3 mb-4">Prescription Re-issuance Requests</h1>
    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Any())
            {
                @foreach (var request in Model)
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">Prescription #@request.PrescriptionId</div>
                                <div class="small text-muted">Patient: @request.Patient?.User?.FullName | @request.RequestDate.ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                            <span class="badge bg-secondary">@request.Status</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(request.DoctorResponse))
                        {
                            <div class="alert alert-light mt-3 mb-0">@request.DoctorResponse</div>
                        }

                        @if (request.Status == HCMS4.Models.ReissueRequestStatus.Pending)
                        {
                            <form asp-action="ReviewReissueRequest" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@request.Id" />
                                <textarea name="doctorResponse" class="form-control mb-2" rows="3" placeholder="Optional response"></textarea>
                                <div class="d-flex gap-2">
                                    <button type="submit" name="approve" value="true" class="btn btn-success">Approve</button>
                                    <button type="submit" name="approve" value="false" class="btn btn-danger">Reject</button>
                                </div>
                            </form>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">No re-issuance requests found.</p>
            }
        </div>
    </div>
</div>
