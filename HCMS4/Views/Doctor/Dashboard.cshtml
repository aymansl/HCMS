@model HCMS4.ViewModels.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Doctor Dashboard</h1>
            <p class="text-muted mb-0">Track appointments, review requests, re-issuance requests, ratings, and articles.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ViewAppointments" class="btn btn-primary">
                <i class="bi bi-calendar-check me-1"></i>Appointments
            </a>
            <a asp-action="MedicalArticles" class="btn btn-outline-info">
                <i class="bi bi-journal-medical me-1"></i>Medical Articles
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <div class="text-muted small">Today's Appointments</div>
                    <div class="display-6 fw-semibold">@Model.TodayAppointmentsCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card dashboard-card h-100 border-warning">
                <div class="card-body">
                    <div class="text-muted small">Pending Re-issuance</div>
                    <div class="display-6 fw-semibold text-warning">@Model.PendingReissueRequestsCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card dashboard-card h-100 border-danger">
                <div class="card-body">
                    <div class="text-muted small">Doctor Review Requests</div>
                    <div class="display-6 fw-semibold text-danger">@Model.PendingReviewRequestsCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card dashboard-card h-100 border-success">
                <div class="card-body">
                    <div class="text-muted small">Average Rating</div>
                    <div class="display-6 fw-semibold text-success">@Model.AverageRating.ToString("0.00")</div>
                    <div class="small text-muted">@Model.RatingCount rating(s)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Ratings</h5>
                    <span class="badge bg-success">@Model.RecentRatings.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.RecentRatings.Any())
                    {
                        @foreach (var rating in Model.RecentRatings)
                        {
                            <div class="border rounded p-3 mb-3">
                                <div class="d-flex justify-content-between">
                                    <div class="fw-semibold">@rating.Patient?.User?.FullName</div>
                                    <div class="text-warning">@(new string('★', rating.Rating))</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(rating.Comment))
                                {
                                    <div class="small mt-2">@rating.Comment</div>
                                }
                                <div class="small text-muted mt-2">@rating.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No ratings yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Notifications</h5>
                    <span class="badge bg-primary">@Model.RecentNotifications.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.RecentNotifications.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notification in Model.RecentNotifications)
                            {
                                <a class="list-group-item list-group-item-action" href="@(notification.LinkUrl ?? "#")">
                                    <div class="fw-semibold">@notification.Title</div>
                                    <div class="small text-muted">@notification.Message</div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No new notifications.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
