@model HCMS4.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2">My Profile</h1>
                <a asp-action="EditProfile" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Edit Profile
                </a>
            </div>
            
            <div class="row">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="bi bi-person-circle display-1 text-primary"></i>
                            </div>
                            <h3>@Model.FullName</h3>
                            <p class="text-muted">@Model.Email</p>
                            
                            
                            <div class="mb-3">
                                @foreach (var role in Model.Roles)
                                {
                                    <span class="badge 
                                        @(role == "Admin" ? "bg-danger" : 
                                          role == "Doctor" ? "bg-primary" : 
                                          role == "Patient" ? "bg-success" : "bg-secondary") 
                                        me-1 mb-1">
                                        @role
                                    </span>
                                }
                            </div>
                            
                            
                            @if (Model.HasDoctorProfile)
                            {
                                <div class="alert alert-info mb-2">
                                    <i class="bi bi-heart-pulse"></i> Doctor Profile
                                </div>
                            }
                            
                            @if (Model.HasPatientProfile)
                            {
                                <div class="alert alert-success mb-2">
                                    <i class="bi bi-person-heart"></i> Patient Profile
                                </div>
                            }
                        </div>
                    </div>
                </div>
                
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Personal Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="row">
                                        <dt class="col-sm-4">First Name:</dt>
                                        <dd class="col-sm-8">@Model.FirstName</dd>
                                        
                                        <dt class="col-sm-4">Last Name:</dt>
                                        <dd class="col-sm-8">@Model.LastName</dd>
                                        
                                        <dt class="col-sm-4">Email:</dt>
                                        <dd class="col-sm-8">@Model.Email</dd>
                                        
                                        <dt class="col-sm-4">Phone:</dt>
                                        <dd class="col-sm-8">
                                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                            {
                                                @Model.PhoneNumber
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not provided</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                            
                           
                            @if (Model.Roles.Contains("Doctor") && (!string.IsNullOrEmpty(Model.Specialization) || !string.IsNullOrEmpty(Model.ContactInfo)))
                            {
                                <hr />
                                <h6 class="mb-3"><i class="bi bi-heart-pulse"></i> Doctor Information</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row">
                                            @if (!string.IsNullOrEmpty(Model.Specialization))
                                            {
                                                <dt class="col-sm-4">Specialization:</dt>
                                                <dd class="col-sm-8">@Model.Specialization</dd>
                                            }
                                            
                                            @if (!string.IsNullOrEmpty(Model.ContactInfo))
                                            {
                                                <dt class="col-sm-4">Contact:</dt>
                                                <dd class="col-sm-8">@Model.ContactInfo</dd>
                                            }
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        @if (!string.IsNullOrEmpty(Model.Qualifications))
                                        {
                                            <dt>Qualifications:</dt>
                                            <dd class="text-muted">@Model.Qualifications</dd>
                                        }
                                    </div>
                                </div>
                            }
                            
                           
                            @if (Model.Roles.Contains("Patient") && (Model.DateOfBirth.HasValue || !string.IsNullOrEmpty(Model.Address)))
                            {
                                <hr />
                                <h6 class="mb-3"><i class="bi bi-person-heart"></i> Patient Information</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row">
                                            @if (Model.DateOfBirth.HasValue)
                                            {
                                                <dt class="col-sm-4">Date of Birth:</dt>
                                                <dd class="col-sm-8">@Model.DateOfBirth.Value.ToString("MMMM dd, yyyy")</dd>
                                            }
                                            
                                            @if (!string.IsNullOrEmpty(Model.EmergencyContact))
                                            {
                                                <dt class="col-sm-4">Emergency Contact:</dt>
                                                <dd class="col-sm-8">@Model.EmergencyContact</dd>
                                            }
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        @if (!string.IsNullOrEmpty(Model.Address))
                                        {
                                            <dt>Address:</dt>
                                            <dd class="text-muted">@Model.Address</dd>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    
                   
                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="mb-0">Change Password</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="ChangePassword" method="post" class="row g-3">
                                <div class="col-md-4">
                                    <label for="CurrentPassword" class="form-label">Current Password</label>
                                    <input type="password" class="form-control" name="CurrentPassword" required />
                                </div>
                                <div class="col-md-4">
                                    <label for="NewPassword" class="form-label">New Password</label>
                                    <input type="password" class="form-control" name="NewPassword" required />
                                </div>
                                <div class="col-md-4">
                                    <label for="ConfirmPassword" class="form-label">Confirm New Password</label>
                                    <input type="password" class="form-control" name="ConfirmPassword" required />
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-warning">
                                        <i class="bi bi-key"></i> Change Password
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>