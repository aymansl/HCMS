@model HCMS4.Models.Drug

@{
    ViewData["Title"] = "Edit Drug";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3">Edit Drug</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item"><a asp-action="Drugs">Drugs Inventory</a></li>
                            <li class="breadcrumb-item active">Edit Drug</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="Drugs" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Inventory
                </a>
            </div>

            <!-- Status Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Main Form Card -->
            <div class="card dashboard-card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Drug Information</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EditDrug" method="post" id="editDrugForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Basic Information -->
                        <h5 class="text-primary mb-3">Basic Information</h5>
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label asp-for="Name" class="form-label">Drug Name <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="form-control" placeholder="Enter drug name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Supplier" class="form-label">Supplier</label>
                                    <input asp-for="Supplier" class="form-control" placeholder="Enter supplier name" />
                                    <span asp-validation-for="Supplier" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing and Stock -->
                        <h5 class="text-primary mb-3 mt-4">Pricing & Stock</h5>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Price" class="form-label">Price <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Price" class="form-control" placeholder="0.00" step="0.01" min="0.01" />
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Quantity" class="form-label">Quantity in Stock <span class="text-danger">*</span></label>
                                    <input asp-for="Quantity" type="number" class="form-control" min="0" placeholder="Enter quantity" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="ExpiryDate" class="form-label">Expiry Date <span class="text-danger">*</span></label>
                                    <input asp-for="ExpiryDate" type="date" class="form-control"
                                           min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Description -->
                        <h5 class="text-primary mb-3 mt-4">Additional Information</h5>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="Description" class="form-label">Description</label>
                                    <textarea asp-for="Description" class="form-control" rows="4"
                                              placeholder="Enter drug description, usage instructions, side effects, or any additional information..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                    <small class="text-muted">Maximum 500 characters</small>
                                </div>
                            </div>
                        </div>

                        <!-- Metadata Information -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <strong>Created:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")<br />
                                    <i class="bi bi-arrow-repeat me-2"></i>
                                    <strong>Last Updated:</strong> @DateTime.Now.ToString("yyyy-MM-dd HH:mm")
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="alert @GetExpiryAlertClass(Model)">
                                    <i class="bi @GetExpiryIconClass(Model) me-2"></i>
                                    <strong>Expiry Status:</strong> @Model.ExpiryStatus<br />
                                    <i class="bi bi-calendar me-2"></i>
                                    <strong>Days Until Expiry:</strong> @((Model.ExpiryDate - DateTime.Now).Days) days
                                </div>
                            </div>
                        </div>

                        <!-- Warning Messages -->
                        @if (Model.Quantity < 10)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Low Stock Warning:</strong> Current quantity (@Model.Quantity) is below the recommended minimum (10 units).
                            </div>
                        }

                        @if (Model.ExpiryDate <= DateTime.Now.AddDays(30))
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Expiry Warning:</strong> This drug expires within 30 days.
                            </div>
                        }

                        @if (Model.ExpiryDate <= DateTime.Now)
                        {
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Expired:</strong> This drug has expired and should be removed from inventory.
                            </div>
                        }

                        <!-- Form Actions -->
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="d-flex justify-content-between">
                                    <button type="button" class="btn btn-outline-danger" onclick="showDeleteConfirmation()">
                                        <i class="bi bi-trash me-1"></i> Delete Drug
                                    </button>
                                    <div>
                                        <a asp-action="Drugs" class="btn btn-outline-secondary me-2">
                                            <i class="bi bi-x-circle me-1"></i> Cancel
                                        </a>
                                        <button type="submit" class="btn btn-primary" id="submitBtn">
                                            <i class="bi bi-save me-1"></i> Save Changes
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Stock Update History Card (Optional - for future enhancement) -->
            @if (Model.Id > 0)
            {
                <div class="card dashboard-card mt-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recent Stock Updates</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted text-center py-3">
                            <i class="bi bi-info-circle me-2"></i>
                            Stock update history will be available in a future update.
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteDrugModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Drug
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="DeleteDrug" method="post" id="deleteDrugForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>

                    @if (Model.PrescriptionItems != null && Model.PrescriptionItems.Any())
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Cannot Delete</strong>
                            <p class="mb-0 mt-2">This drug is associated with @Model.PrescriptionItems.Count existing prescription(s) and cannot be deleted.</p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            This action cannot be undone. All data associated with this drug will be permanently deleted.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    @if (Model.PrescriptionItems == null || !Model.PrescriptionItems.Any())
                    {
                        <button type="submit" class="btn btn-danger" id="confirmDeleteBtn">
                            <i class="bi bi-trash me-1"></i>Delete Drug
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Set minimum date for expiry date picker
        document.addEventListener('DOMContentLoaded', function() {
            const expiryDateInput = document.getElementById('ExpiryDate');
            if (expiryDateInput) {
                const tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                expiryDateInput.min = tomorrow.toISOString().split('T')[0];
            }

            // Price input validation
            const priceInput = document.getElementById('Price');
            if (priceInput) {
                priceInput.addEventListener('input', function(e) {
                    let value = this.value.replace(/[^0-9.]/g, '');
                    // Ensure only one decimal point
                    const parts = value.split('.');
                    if (parts.length > 2) {
                        value = parts[0] + '.' + parts.slice(1).join('');
                    }
                    // Limit to 2 decimal places
                    if (parts.length === 2 && parts[1].length > 2) {
                        value = parts[0] + '.' + parts[1].substring(0, 2);
                    }
                    this.value = value;
                });

                priceInput.addEventListener('blur', function(e) {
                    if (this.value) {
                        // Format to 2 decimal places
                        const num = parseFloat(this.value);
                        if (!isNaN(num)) {
                            this.value = num.toFixed(2);
                        }
                    }
                });
            }

            // Quantity input validation
            const quantityInput = document.getElementById('Quantity');
            if (quantityInput) {
                quantityInput.addEventListener('input', function(e) {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            }
        });

        // Character counter for description
        document.getElementById('Description')?.addEventListener('input', function() {
            const maxLength = 500;
            const currentLength = this.value.length;
            const remaining = maxLength - currentLength;

            // Create or update counter
            let counter = document.querySelector('.description-counter');
            if (!counter) {
                counter = document.createElement('small');
                counter.className = 'text-muted float-end description-counter';
                this.parentElement.appendChild(counter);
            }

            counter.textContent = `${currentLength}/${maxLength} characters`;

            if (remaining < 50) {
                counter.classList.add('text-warning');
            } else {
                counter.classList.remove('text-warning');
            }
        });

        // Delete confirmation modal
        function showDeleteConfirmation() {
            var modal = new bootstrap.Modal(document.getElementById('deleteDrugModal'));
            modal.show();
        }

        // Prevent double submission
        document.getElementById('editDrugForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...';
        });

        document.getElementById('deleteDrugForm')?.addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('confirmDeleteBtn');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Deleting...';
            }
        });

        // Confirm before leaving with unsaved changes
        let formChanged = false;
        const form = document.getElementById('editDrugForm');
        const inputs = form.querySelectorAll('input, textarea, select');

        inputs.forEach(input => {
            input.addEventListener('change', function() {
                formChanged = true;
            });
        });

        window.addEventListener('beforeunload', function(e) {
            if (formChanged) {
                e.preventDefault();
                e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
            }
        });

        form.addEventListener('submit', function() {
            formChanged = false;
        });
    </script>
}

@functions {
    string GetExpiryAlertClass(HCMS4.Models.Drug drug)
    {
        var daysUntilExpiry = (drug.ExpiryDate - DateTime.Now).Days;
        if (daysUntilExpiry <= 0)
            return "alert-danger";
        if (daysUntilExpiry <= 30)
            return "alert-warning";
        return "alert-success";
    }

    string GetExpiryIconClass(HCMS4.Models.Drug drug)
    {
        var daysUntilExpiry = (drug.ExpiryDate - DateTime.Now).Days;
        if (daysUntilExpiry <= 0)
            return "bi-calendar-x";
        if (daysUntilExpiry <= 30)
            return "bi-exclamation-triangle";
        return "bi-check-circle";
    }
}

<style>
    /* Custom styles for the edit drug form */
    .input-group-text {
        background-color: #f8f9fa;
    }

    .card-header.bg-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .form-label {
        font-weight: 500;
        color: #495057;
    }

    .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    /* Required field indicator */
    label span.text-danger {
        font-size: 1.2em;
        margin-left: 2px;
    }

    /* Metadata alerts */
    .alert-info {
        background-color: #f0f7ff;
        border-left: 4px solid #667eea;
    }

    .alert-success {
        border-left: 4px solid #28a745;
    }

    .alert-warning {
        border-left: 4px solid #ffc107;
    }

    .alert-danger {
        border-left: 4px solid #dc3545;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 1rem;
        }

        .btn-outline-secondary, .btn-outline-danger {
            width: 100%;
        }

        .d-flex.justify-content-between > div {
            width: 100%;
        }

        .btn-primary, .btn-outline-secondary {
            width: 100%;
            margin: 0.25rem 0;
        }
    }
</style>