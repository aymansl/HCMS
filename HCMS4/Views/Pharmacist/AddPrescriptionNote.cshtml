@model HCMS4.ViewModels.PrescriptionNoteFormViewModel

@{
    ViewData["Title"] = "Add Prescription Note";
    Layout = "_LayoutAuth";
}

<div class="container py-4">
    <div class="card dashboard-card">
        <div class="card-header">
            <h4 class="mb-0">Add Medical Note</h4>
        </div>
        <div class="card-body">
            <p class="text-muted">Prescription #@Model.PrescriptionId | Patient: @Model.PatientName | Doctor: @Model.DoctorName</p>
            <form asp-action="AddPrescriptionNote" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="PrescriptionId" type="hidden" />
                <input asp-for="PatientName" type="hidden" />
                <input asp-for="DoctorName" type="hidden" />

                <div class="mb-3">
                    <label asp-for="NoteText" class="form-label"></label>
                    <textarea asp-for="NoteText" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="NoteText" class="text-danger"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="NotifyDoctor" class="form-check-input" />
                    <label asp-for="NotifyDoctor" class="form-check-label">Notify Doctor</label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Note</button>
                    <a asp-action="PrescriptionDetails" asp-route-id="@Model.PrescriptionId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
