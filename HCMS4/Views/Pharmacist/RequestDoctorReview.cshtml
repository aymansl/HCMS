@model HCMS4.ViewModels.PrescriptionReviewRequestFormViewModel

@{
    ViewData["Title"] = "Request Doctor Review";
    Layout = "_LayoutAuth";
}

<div class="container py-4">
    <div class="card dashboard-card">
        <div class="card-header">
            <h4 class="mb-0">Request Doctor Review</h4>
        </div>
        <div class="card-body">
            <p class="text-muted">Prescription #@Model.PrescriptionId | Patient: @Model.PatientName | Doctor: @Model.DoctorName</p>
            <form asp-action="RequestDoctorReview" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="PrescriptionId" type="hidden" />
                <input asp-for="PatientName" type="hidden" />
                <input asp-for="DoctorName" type="hidden" />

                <div class="mb-3">
                    <label asp-for="ReasonForReview" class="form-label"></label>
                    <select asp-for="ReasonForReview" asp-items="Html.GetEnumSelectList<HCMS4.Models.ReviewReason>()" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="AdditionalComments" class="form-label"></label>
                    <textarea asp-for="AdditionalComments" class="form-control" rows="4"></textarea>
                </div>
                <div class="mb-4">
                    <label asp-for="SuggestedAlternative" class="form-label"></label>
                    <input asp-for="SuggestedAlternative" class="form-control" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Send Request</button>
                    <a asp-action="PrescriptionDetails" asp-route-id="@Model.PrescriptionId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
