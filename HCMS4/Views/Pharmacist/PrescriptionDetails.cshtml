@model HCMS4.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
    Layout = "_LayoutAuth";
    var pharmacistNotes = ViewBag.PharmacistNotes as List<HCMS4.Models.PharmacistPrescriptionNote> ?? new();
    var doctorReviewRequests = ViewBag.DoctorReviewRequests as List<HCMS4.Models.DoctorReviewRequest> ?? new();
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3">Prescription Details</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item"><a asp-action="Prescriptions">Prescriptions</a></li>
                            <li class="breadcrumb-item active">Details #@Model.Id</li>
                        </ol>
                    </nav>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Prescriptions" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    @if (Model.Status == PrescriptionStatus.Pending)
                    {
                        <form asp-action="MarkPrescriptionCompleted" asp-route-id="@Model.Id"
                              method="post" style="display: inline;"
                              onsubmit="return confirm('Mark this prescription as completed?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg"></i> Mark as Completed
                            </button>
                        </form>
                    }
                    <a asp-action="RequestDoctorReview" asp-route-prescriptionId="@Model.Id" class="btn btn-outline-warning">
                        <i class="bi bi-arrow-repeat"></i> Request Doctor Review
                    </a>
                    <a asp-action="AddPrescriptionNote" asp-route-prescriptionId="@Model.Id" class="btn btn-outline-info">
                        <i class="bi bi-journal-plus"></i> Add Medical Note
                    </a>
                </div>
            </div>

            <!-- Status Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row">
                <!-- Main Content - Left Column -->
                <div class="col-lg-8">
                    <!-- Prescription Info Card -->
                    <div class="card dashboard-card mb-4">
                        <div class="card-header bg-gradient-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-prescription2 me-2"></i>
                                Prescription #@Model.Id
                                @switch (Model.Status)
                                {
                                    case PrescriptionStatus.Pending:
                                        <span class="badge bg-warning ms-2">Pending</span>
                                        break;
                                    case PrescriptionStatus.Completed:
                                        <span class="badge bg-success ms-2">Completed</span>
                                        break;
                                    case PrescriptionStatus.Canceled:
                                        <span class="badge bg-danger ms-2">Cancelled</span>
                                        break;
                                }
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="text-muted small text-uppercase">Prescription Date</label>
                                        <p class="h6 mb-0">@Model.PrescriptionDate.ToString("dddd, MMMM d, yyyy")</p>
                                        <p class="text-muted small">@Model.PrescriptionDate.ToString("hh:mm tt")</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="text-muted small text-uppercase">Last Updated</label>
                                        <p class="h6 mb-0">@(Model.UpdatedAt.ToString("dddd, MMMM d, yyyy") ?? "N/A")</p>
                                        <p class="text-muted small">@(Model.UpdatedAt.ToString("hh:mm tt") ?? "")</p>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="mt-3">
                                    <label class="text-muted small text-uppercase">Notes</label>
                                    <div class="bg-light p-3 rounded">
                                        <p class="mb-0">@Model.Notes</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Prescription Items Card -->
                    <div class="card dashboard-card mb-4">
                        <div class="card-header bg-gradient-info text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-capsule me-2"></i>
                                Prescribed Medications
                                <span class="badge bg-light text-info ms-2">@(Model.PrescriptionItems?.Count ?? 0) items</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Model.PrescriptionItems != null && Model.PrescriptionItems.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Medication</th>
                                                <th class="text-center">Qty</th>
                                                <th>Dosage</th>
                                                <th>Duration</th>
                                                <th>Instructions</th>
                                                <th class="text-end">Price</th>
                                                <th class="text-end">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.PrescriptionItems)
                                            {
                                                var itemTotal = item.Quantity * (item.Drug?.Price ?? 0);
                                                <tr>
                                                    <td>
                                                        <strong>@(item.Drug?.Name ?? "Unknown")</strong>
                                                        @if (!string.IsNullOrEmpty(item.Drug?.Supplier))
                                                        {
                                                            <div class="text-muted small">@item.Drug.Supplier</div>
                                                        }
                                                    </td>
                                                    <td class="text-center">@item.Quantity</td>
                                                    <td>@(item.Dosage ?? "As prescribed")</td>
                                                    <td>@(item.Duration ?? "As directed")</td>
                                                    <td>
                                                        <span class="small">@(string.IsNullOrEmpty(item.Instructions) ? "Take as directed" : item.Instructions)</span>
                                                    </td>
                                                    <td class="text-end">@(item.Drug?.Price.ToString("C") ?? "N/A")</td>
                                                    <td class="text-end fw-bold">@itemTotal.ToString("C")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="6" class="text-end"><strong>Total:</strong></td>
                                                <td class="text-end fw-bold text-primary">
                                                    @(Model.PrescriptionItems.Sum(i => i.Quantity * (i.Drug?.Price ?? 0)).ToString("C"))
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                @if (Model.Status == PrescriptionStatus.Completed)
                                {
                                    <div class="alert alert-success mt-3">
                                        <div class="d-flex">
                                            <div class="me-3">
                                                <i class="bi bi-check-circle-fill fs-4"></i>
                                            </div>
                                            <div>
                                                <strong>Prescription Completed</strong>
                                                <p class="mb-0">Inventory has been updated. The prescribed quantities have been deducted from stock.</p>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Inventory Check Alert -->
                                @if (Model.PrescriptionItems.Any(i => i.Drug != null && i.Drug.Quantity < i.Quantity))
                                {
                                    <div class="alert alert-danger mt-3">
                                        <div class="d-flex">
                                            <div class="me-3">
                                                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                                            </div>
                                            <div>
                                                <strong>Inventory Alert:</strong> Some medications are low in stock or unavailable.
                                                <ul class="mt-2 mb-0">
                                                    @foreach (var item in Model.PrescriptionItems.Where(i => i.Drug != null && i.Drug.Quantity < i.Quantity))
                                                    {
                                                        <li>@item.Drug.Name: Required @item.Quantity, Available @item.Drug.Quantity</li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-capsule display-1 text-muted"></i>
                                    <p class="mt-3 text-muted">No medications listed in this prescription.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Sidebar - Right Column -->
                <div class="col-lg-4">
                    <!-- Patient Information Card -->
                    <div class="card dashboard-card mb-4">
                        <div class="card-header bg-gradient-success text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-person-circle me-2"></i>
                                Patient Information
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Model.Patient != null)
                            {
                                <div class="text-center mb-3">
                                    <div class="avatar-circle bg-success-light mx-auto mb-2">
                                        <i class="bi bi-person-fill text-success fs-1"></i>
                                    </div>
                                    <h5 class="mb-1">@Model.Patient.User?.FullName</h5>
                                    <span class="badge bg-success">ID: @Model.Patient.Id</span>
                                </div>

                                <hr />

                                <div class="info-item mb-2">
                                    <i class="bi bi-envelope text-muted me-2"></i>
                                    <span>@(Model.Patient.User?.Email ?? "N/A")</span>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Patient.User?.PhoneNumber))
                                {
                                    <div class="info-item mb-2">
                                        <i class="bi bi-telephone text-muted me-2"></i>
                                        <span>@Model.Patient.User.PhoneNumber</span>
                                    </div>
                                }

                                @if (Model.Patient.DateOfBirth.HasValue)
                                {
                                    <div class="info-item mb-2">
                                        <i class="bi bi-calendar text-muted me-2"></i>
                                        <span>DOB: @Model.Patient.DateOfBirth.Value.ToString("yyyy-MM-dd")</span>
                                        <span class="text-muted small ms-2">
                                            (@(DateTime.Now.Year - Model.Patient.DateOfBirth.Value.Year) years)
                                        </span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Model.Patient.Address))
                                {
                                    <div class="info-item mb-2">
                                        <i class="bi bi-geo-alt text-muted me-2"></i>
                                        <span>@Model.Patient.Address</span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Model.Patient.EmergencyContact))
                                {
                                    <div class="mt-3 pt-2 border-top">
                                        <small class="text-muted text-uppercase">Emergency Contact</small>
                                        <p class="mb-0 fw-medium">@Model.Patient.EmergencyContact</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted text-center py-3">Patient information not available.</p>
                            }
                        </div>
                    </div>

                    <!-- Doctor Information Card -->
                    <div class="card dashboard-card mb-4">
                        <div class="card-header bg-gradient-warning text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-person-badge me-2"></i>
                                Prescribing Doctor
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Model.Doctor != null)
                            {
                                <div class="text-center mb-3">
                                    <div class="avatar-circle bg-warning-light mx-auto mb-2">
                                        <i class="bi bi-person-badge-fill text-warning fs-1"></i>
                                    </div>
                                    <h5 class="mb-1">@Model.Doctor.User?.FullName</h5>
                                    <span class="badge bg-warning text-dark">ID: @Model.Doctor.Id</span>
                                </div>

                                <hr />

                                @if (!string.IsNullOrEmpty(Model.Doctor.SpecializationName))
                                {
                                    <div class="info-item mb-2">
                                        <i class="bi bi-star text-muted me-2"></i>
                                        <span>@Model.Doctor.Specialization</span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Model.Doctor.User?.Email))
                                {
                                    <div class="info-item mb-2">
                                        <i class="bi bi-envelope text-muted me-2"></i>
                                        <span>@Model.Doctor.User.Email</span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Model.Doctor.ContactInfo))
                                {
                                    <div class="info-item mb-2">
                                        <i class="bi bi-telephone text-muted me-2"></i>
                                        <span>@Model.Doctor.ContactInfo</span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Model.Doctor.Qualifications))
                                {
                                    <div class="mt-3 pt-2 border-top">
                                        <small class="text-muted text-uppercase">Qualifications</small>
                                        <p class="mb-0 fw-medium">@Model.Doctor.Qualifications</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted text-center py-3">Doctor information not available.</p>
                            }
                        </div>
                    </div>

                    <!-- Quick Actions Card -->
                    <div class="card dashboard-card">
                        <div class="card-header bg-gradient-secondary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-lightning-charge me-2"></i>
                                Quick Actions
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a asp-action="Drugs" class="btn btn-outline-primary">
                                    <i class="bi bi-capsule me-2"></i> Check Drug Inventory
                                </a>

                                <button type="button" class="btn btn-outline-info" onclick="window.print()">
                                    <i class="bi bi-printer me-2"></i> Print Prescription
                                </button>

                                @if (Model.Status == PrescriptionStatus.Pending)
                                {
                                    <form asp-action="MarkPrescriptionCompleted" asp-route-id="@Model.Id"
                                          method="post" onsubmit="return confirm('Mark this prescription as completed?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success w-100">
                                            <i class="bi bi-check-lg me-2"></i> Mark as Completed
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card dashboard-card mt-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Pharmacist Notes</h5>
                        </div>
                        <div class="card-body">
                            @if (pharmacistNotes.Any())
                            {
                                @foreach (var note in pharmacistNotes)
                                {
                                    <div class="border rounded p-3 mb-3">
                                        <div class="fw-semibold">@note.Pharmacist?.User?.FullName</div>
                                        <div>@note.NoteText</div>
                                        <div class="small text-muted mt-1">@note.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">No pharmacist notes have been added.</p>
                            }
                        </div>
                    </div>

                    <div class="card dashboard-card mt-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Doctor Review Requests</h5>
                        </div>
                        <div class="card-body">
                            @if (doctorReviewRequests.Any())
                            {
                                @foreach (var request in doctorReviewRequests)
                                {
                                    <div class="border rounded p-3 mb-3">
                                        <div class="fw-semibold">@request.ReasonForReview</div>
                                        @if (!string.IsNullOrWhiteSpace(request.AdditionalComments))
                                        {
                                            <div>@request.AdditionalComments</div>
                                        }
                                        <div class="small text-muted mt-1">Status: @request.Status | @request.RequestDate.ToString("yyyy-MM-dd HH:mm")</div>
                                        @if (!string.IsNullOrWhiteSpace(request.DoctorResponse))
                                        {
                                            <div class="alert alert-light mt-2 mb-0">
                                                <strong>Doctor response:</strong> @request.DoctorResponse
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">No doctor review requests were sent for this prescription.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Prevent double submission
        document.querySelectorAll('form[action*="MarkPrescriptionCompleted"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                const submitBtn = this.querySelector('button[type="submit"]');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Processing...';
            });
        });
    </script>
}

<style>
    /* Gradient Headers */
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #17a2b8 0%, #0dcaf0 100%);
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .bg-gradient-secondary {
        background: linear-gradient(135deg, #868e96 0%, #6c757d 100%);
    }

    /* Avatar Circles */
    .avatar-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-success-light {
        background-color: rgba(40, 167, 69, 0.1);
    }

    .bg-warning-light {
        background-color: rgba(255, 193, 7, 0.1);
    }

    /* Info Items */
    .info-item {
        display: flex;
        align-items: center;
        padding: 0.25rem 0;
    }

        .info-item i {
            width: 24px;
            font-size: 1.1rem;
        }

    /* Table Enhancements */
    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    .table tfoot {
        border-top: 2px solid #dee2e6;
    }

    /* Badge Styles */
    .badge {
        padding: 0.5rem 0.75rem;
        font-weight: 500;
        font-size: 0.75rem;
    }

    /* Card Enhancements */
    .dashboard-card {
        border: none;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-2px);
        }

    .card-header {
        border-bottom: none;
        padding: 1rem 1.25rem;
    }

        .card-header h5 {
            font-weight: 600;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    /* Text Utilities */
    .text-uppercase {
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 1rem;
        }

        .d-flex.gap-2 {
            width: 100%;
        }

            .d-flex.gap-2 .btn {
                flex: 1;
            }

        .table {
            font-size: 0.85rem;
        }

        .avatar-circle {
            width: 50px;
            height: 50px;
        }

            .avatar-circle i {
                font-size: 1.5rem !important;
            }
    }

    /* Print Styles */
    @@media print {
        .btn, .breadcrumb, .d-flex.justify-content-between,
        .card-header, footer, header, .quick-actions {
            display: none !important;
        }

        .card {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
            break-inside: avoid;
        }

        body {
            background: white;
            padding: 20px;
        }

        .container-fluid {
            padding: 0;
        }

        .badge {
            border: 1px solid #000;
            color: #000 !important;
            background: transparent !important;
        }
    }
</style>
