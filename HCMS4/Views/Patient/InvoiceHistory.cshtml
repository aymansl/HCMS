@model List<HCMS4.ViewModels.InvoiceViewModel>

@{
    ViewData["Title"] = "Invoice History";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3">My Invoice History</h1>
                <a asp-action="Dashboard" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
            </div>

            <div class="card dashboard-card">
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-receipt display-1 text-muted"></i>
                            <h3 class="mt-4">No invoices found</h3>
                            <p class="text-muted">You don't have any invoices yet.</p>
                            <a asp-action="BookAppointment" class="btn btn-primary mt-3">
                                <i class="bi bi-plus-circle"></i> Book an Appointment
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover" id="invoicesTable">
                                <thead>
                                    <tr>
                                        <th>Invoice #</th>
                                        <th>Date</th>
                                        <th>Doctor</th>
                                        <th>Consultation</th>
                                        <th>Medication</th>
                                        <th>Total</th>
                                        <th>Payment Status</th>
                                        <th>Balance</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@invoice.InvoiceNumber</div>
                                                <div class="text-muted small">@invoice.InvoiceDate.ToString("yyyy-MM-dd")</div>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@invoice.InvoiceDate.ToString("MMM dd, yyyy")</div>
                                                <div class="text-muted small">@invoice.InvoiceDate.ToString("hh:mm tt")</div>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@invoice.DoctorName</div>
                                                @if (invoice.AppointmentDate.HasValue)
                                                {
                                                    <div class="text-muted small">@invoice.AppointmentDate.Value.ToString("MMM dd")</div>
                                                }
                                            </td>
                                            <td class="text-end">@invoice.ConsultationFee.ToString("C2")</td>
                                            <td class="text-end">@invoice.MedicationTotal.ToString("C2")</td>
                                            <td class="text-end fw-bold">@invoice.TotalAmount.ToString("C2")</td>
                                            <td>
                                                <span class="badge @invoice.StatusBadgeClass">@invoice.PaymentStatus</span>
                                            </td>
                                            <td class="text-end">
                                                @if (invoice.Balance > 0)
                                                {
                                                    <span class="text-danger fw-semibold">@invoice.Balance.ToString("C2")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-success fw-semibold">@invoice.Balance.ToString("C2")</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="InvoiceDetails" asp-route-id="@invoice.Id" 
                                                       class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-eye"></i> View
                                                    </a>
                                                    @if (invoice.Balance > 0)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-success"
                                                                onclick="showPaymentModal(@invoice.Id, @invoice.Balance)">
                                                            <i class="bi bi-credit-card"></i> Pay
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-light">
                                        <td colspan="4" class="text-end fw-bold">Totals:</td>
                                        <td class="text-end fw-bold">@Model.Sum(i => i.ConsultationFee).ToString("C2")</td>
                                        <td class="text-end fw-bold">@Model.Sum(i => i.MedicationTotal).ToString("C2")</td>
                                        <td class="text-end fw-bold">@Model.Sum(i => i.TotalAmount).ToString("C2")</td>
                                        <td class="text-end fw-bold">@Model.Sum(i => i.Balance).ToString("C2")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <div class="text-muted">
                                Showing @Model.Count invoice(s)
                                @{
                                    var totalBalance = Model.Sum(i => i.Balance);
                                    if (totalBalance > 0)
                                    {
                                        <span class="text-danger ms-2">Total Outstanding: @totalBalance.ToString("C2")</span>
                                    }
                                }
                            </div>
                            <div class="btn-group">
                                <a asp-action="Dashboard" class="btn btn-outline-secondary">
                                    <i class="bi bi-house"></i> Dashboard
                                </a>
                                <a asp-action="BookAppointment" class="btn btn-primary">
                                    <i class="bi bi-plus-circle"></i> Book Appointment
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Make Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="paymentForm" method="post" asp-action="ProcessPayment">
                    <input type="hidden" id="paymentInvoiceId" name="invoiceId" />
                    
                    <div class="mb-3">
                        <label class="form-label">Invoice #</label>
                        <input type="text" class="form-control" id="paymentInvoiceNumber" readonly>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Total Amount Due</label>
                        <input type="text" class="form-control" id="paymentTotalAmount" readonly>
                    </div>
                    
                    <div class="mb-3">
                        <label for="paymentAmount" class="form-label">Payment Amount</label>
                        <input type="number" class="form-control" id="paymentAmount" name="amount" 
                               step="0.01" min="0.01" required>
                        <div class="form-text">Enter the amount you wish to pay</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="paymentMethod" class="form-label">Payment Method</label>
                        <select class="form-select" id="paymentMethod" name="paymentMethod" required>
                            <option value="">Select Payment Method</option>
                            <option value="Credit Card">Credit Card</option>
                            <option value="Debit Card">Debit Card</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Cash">Cash</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label for="paymentNotes" class="form-label">Notes (Optional)</label>
                        <textarea class="form-control" id="paymentNotes" name="notes" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="paymentForm" class="btn btn-primary">Submit Payment</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            if (document.getElementById('invoicesTable')) {
                $('#invoicesTable').DataTable({
                    "order": [[0, "desc"]], 
                    "pageLength": 10,
                    "language": {
                        "search": "Search invoices:",
                        "emptyTable": "No invoices found",
                        "info": "Showing _START_ to _END_ of _TOTAL_ invoices",
                        "infoEmpty": "Showing 0 to 0 of 0 invoices",
                        "lengthMenu": "Show _MENU_ invoices"
                    },
                    "columnDefs": [
                        { "orderable": true, "targets": [0, 1, 6] },
                        { "orderable": false, "targets": [2, 3, 4, 5, 7, 8] } 
                    ]
                });
            }
        });

        function showPaymentModal(invoiceId, balance) {
            const invoiceNumber = "INV-" + invoiceId.toString().padStart(6, '0');
            
            document.getElementById('paymentInvoiceId').value = invoiceId;
            document.getElementById('paymentInvoiceNumber').value = invoiceNumber;
            document.getElementById('paymentTotalAmount').value = '$' + balance.toFixed(2);
            document.getElementById('paymentAmount').value = balance.toFixed(2);
            document.getElementById('paymentAmount').max = balance;
            
            const paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));
            paymentModal.show();
        }
    </script>
    
    <style>
        .dashboard-card {
            border-radius: 10px;
            border: 1px solid #e0e0e0;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.4em 0.8em;
        }
        
        .bg-success {
            background-color: #198754 !important;
        }
        
        .bg-warning {
            background-color: #ffc107 !important;
        }
        
        .bg-secondary {
            background-color: #6c757d !important;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(0, 123, 255, 0.05);
        }
        
       
        tr.balance-unpaid {
            background-color: rgba(255, 193, 7, 0.05);
        }
       
        @@media (max-width: 768px) {
            .table-responsive {
                font-size: 0.9rem;
            }
            
            .btn-group .btn {
                padding: 0.25rem 0.5rem;
                font-size: 0.875rem;
            }
        }
    </style>
}