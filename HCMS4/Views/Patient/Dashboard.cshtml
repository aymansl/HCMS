@model HCMS4.ViewModels.PatientDashboardViewModel

@{
    ViewData["Title"] = "Patient Dashboard";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Patient Dashboard</h1>
            <p class="text-muted mb-0">Your appointments, surveys, complaints, and published medical articles.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="BookAppointment" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Book Appointment
            </a>
            <a asp-action="Surveys" class="btn btn-outline-success">
                <i class="bi bi-clipboard-check me-1"></i>Surveys
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <div class="text-muted small">Upcoming Appointments</div>
                    <div class="display-6 fw-semibold">@Model.UpcomingAppointmentsCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <div class="text-muted small">Completed Visits</div>
                    <div class="display-6 fw-semibold">@Model.CompletedVisitsCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card dashboard-card h-100 border-success">
                <div class="card-body">
                    <div class="text-muted small">Active Surveys</div>
                    <div class="display-6 fw-semibold text-success">@Model.ActiveSurveyCount</div>
                    @if (Model.ActiveSurveyCount > 0)
                    {
                        <div class="small mt-2 text-success">You have a new survey to complete.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card dashboard-card h-100 border-warning">
                <div class="card-body">
                    <div class="text-muted small">Open Complaints</div>
                    <div class="display-6 fw-semibold text-warning">@Model.OpenComplaintCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Upcoming Appointments</h5>
                    <a asp-action="ViewAppointmentHistory" class="btn btn-sm btn-outline-primary">History</a>
                </div>
                <div class="card-body">
                    @if (Model.UpcomingAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Doctor</th>
                                        <th>Specialization</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in Model.UpcomingAppointments)
                                    {
                                        <tr>
                                            <td>@appointment.AppointmentDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>Dr. @appointment.DoctorName</td>
                                            <td>@appointment.Specialization</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No upcoming appointments.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Notifications</h5>
                    <span class="badge bg-primary">@Model.RecentNotifications.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.RecentNotifications.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notification in Model.RecentNotifications)
                            {
                                <a class="list-group-item list-group-item-action" href="@(notification.LinkUrl ?? "#")">
                                    <div class="fw-semibold">@notification.Title</div>
                                    <div class="small text-muted">@notification.Message</div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No new notifications.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card dashboard-card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Published Medical Articles</h5>
            <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary">Public Home</a>
        </div>
        <div class="card-body">
            @if (Model.PublishedArticles.Any())
            {
                <div class="row g-4">
                    @foreach (var article in Model.PublishedArticles)
                    {
                        var summary = !string.IsNullOrWhiteSpace(article.Summary)
                            ? article.Summary
                            : article.Content.Length > 180 ? article.Content.Substring(0, 180) + "..." : article.Content;
                        <div class="col-md-6 col-xl-4">
                            <div class="card article-card h-100 border-0 shadow-sm overflow-hidden">
                                <div class="article-card-top">
                                    <span class="article-category">@(!string.IsNullOrWhiteSpace(article.Category) ? article.Category : "General Health")</span>
                                    <span class="article-live-badge">Published</span>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="article-title">@article.Title</h5>
                                    <p class="article-summary text-muted flex-grow-1">@summary</p>
                                    <div class="article-meta mt-3">
                                        <div class="fw-semibold">Dr. @article.Doctor?.FullName</div>
                                        <div class="text-muted small">Published @((article.PublishedAt ?? article.CreatedAt).ToString("MMM dd, yyyy"))</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No published articles yet.</p>
            }
        </div>
    </div>
</div>

<style>
    .article-card {
        border-radius: 18px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid rgba(15, 23, 42, 0.08) !important;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .article-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12) !important;
    }

    .article-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1rem 0;
    }

    .article-category,
    .article-live-badge {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
    }

    .article-category {
        background: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
    }

    .article-live-badge {
        background: rgba(25, 135, 84, 0.12);
        color: #198754;
    }

    .article-title {
        margin-top: 1rem;
        margin-bottom: 0.75rem;
        line-height: 1.25;
    }

    .article-summary {
        font-size: 0.95rem;
        line-height: 1.7;
    }

    .article-meta {
        border-top: 1px solid rgba(15, 23, 42, 0.08);
        padding-top: 0.9rem;
    }
</style>
