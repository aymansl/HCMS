@model List<HCMS4.Models.Complaint>

@{
    ViewData["Title"] = "Complaints";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">My Complaints</h1>
        <a asp-action="CreateComplaint" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>New Complaint
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Tracking #</th>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Submitted</th>
                                <th>Attachment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var complaint in Model)
                            {
                                <tr>
                                    <td>@complaint.TrackingNumber</td>
                                    <td>@complaint.Title</td>
                                    <td>@complaint.Type</td>
                                    <td><span class="badge bg-secondary">@complaint.Status</span></td>
                                    <td>@complaint.SubmissionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(complaint.AttachmentPath))
                                        {
                                            <a href="@complaint.AttachmentPath" target="_blank">View</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No complaints have been submitted yet.</p>
            }
        </div>
    </div>
</div>
