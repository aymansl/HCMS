@model HCMS4.Modules.Lab.ViewModels.LabTestFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row mb-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">Test Name *</label>
        <input asp-for="Name" class="form-control" placeholder="e.g., CBC" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Unit" class="form-label">Unit *</label>
        <input asp-for="Unit" class="form-control" placeholder="e.g., 10^9/L" />
        <span asp-validation-for="Unit" class="text-danger"></span>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <label asp-for="ReferenceMin" class="form-label"></label>
        <input asp-for="ReferenceMin" class="form-control" type="number" step="any" />
        <span asp-validation-for="ReferenceMin" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ReferenceMax" class="form-label"></label>
        <input asp-for="ReferenceMax" class="form-control" type="number" step="any" />
        <span asp-validation-for="ReferenceMax" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Price" class="form-label">Price *</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
</div>
<p class="text-muted small">Leave both reference values empty for a qualitative test.</p>
