@model HCMS4.Modules.Lab.ViewModels.LabTestFormViewModel

@{
    ViewData["Title"] = "Edit Test";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Edit Test</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Tests">Test Catalogue</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Tests" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Catalogue
        </a>
    </div>

    <div class="card dashboard-card">
        <div class="card-body">
            <form asp-action="EditTest" asp-route-id="@Model.Id" method="post">
                <partial name="_LabTestForm" model="Model" />
                <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                    <div class="text-muted small">Inactive tests stay in past requests but cannot be ordered.</div>
                </div>
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Tests" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
