@model IEnumerable<HCMS4.Modules.Lab.Models.LabNote>
@* The lab's notes on a request, newest first (UC-L07); shared by the lab and doctor pages. *@

@if (!Model.Any())
{
    <p class="text-muted mb-0" id="no-lab-notes">No notes yet.</p>
}
else
{
    <ul class="list-group list-group-flush" id="lab-notes-list">
        @foreach (var note in Model.OrderByDescending(n => n.CreatedAt).ThenByDescending(n => n.Id))
        {
            <li class="list-group-item px-0">
                @if (note.IsUrgent)
                {
                    <span class="badge bg-danger me-1">Urgent</span>
                }
                @note.Text
                <div class="small text-muted">@note.Author.FullName · @note.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
            </li>
        }
    </ul>
}
