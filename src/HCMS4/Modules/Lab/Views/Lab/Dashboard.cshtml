@model HCMS4.Modules.Lab.ViewModels.LabDashboardViewModel

@{
    ViewData["Title"] = "Lab Dashboard";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-eyedropper me-2"></i>Lab Dashboard</h1>
            <p class="text-muted mb-0" id="lab-welcome">Welcome, @Model.TechnicianName</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-inbox me-2"></i>Incoming Requests</h5>
                    <p class="display-6 mb-1" id="lab-new-requests">@Model.NewRequestCount</p>
                    @if (Model.NewRequests.Count == 0)
                    {
                        <p class="text-muted mb-0">No new requests.</p>
                    }
                    else
                    {
                        <p class="text-muted">New requests waiting for receipt, oldest first.</p>
                        <ul class="list-group list-group-flush">
                            @foreach (var request in Model.NewRequests)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>
                                        <strong>#@request.Id</strong> @request.Patient.User.FullName
                                        <span class="text-muted small">· @request.RequestedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                    </span>
                                    <a asp-controller="Lab" asp-action="RequestDetails" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">Open</a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-list-check me-2"></i>Test Catalogue</h5>
                    <p class="display-6 mb-1" id="lab-active-tests">@Model.ActiveTestCount</p>
                    <p class="text-muted">Active tests, with their units, reference ranges and prices.</p>
                    <a asp-controller="Lab" asp-action="Tests" class="btn btn-sm btn-outline-primary">Open Catalogue</a>
                </div>
            </div>
        </div>
    </div>
</div>
