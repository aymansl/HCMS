@model HCMS4.Modules.Lab.ViewModels.LabIncomingRequestsViewModel
@using HCMS4.Modules.Lab.Services
@using HCMS4.Modules.Lab.ViewModels

@{
    ViewData["Title"] = "Incoming Requests";
    Layout = "_LayoutAuth";
    var statusNames = new Dictionary<HCMS4.Modules.Lab.Models.LabRequestStatus, string>
    {
        [HCMS4.Modules.Lab.Models.LabRequestStatus.Requested] = "Requested",
        [HCMS4.Modules.Lab.Models.LabRequestStatus.Received] = "Received",
        [HCMS4.Modules.Lab.Models.LabRequestStatus.InProgress] = "In Progress"
    };
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Incoming Requests</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active">Incoming Requests</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card dashboard-card mb-3">
        <div class="card-body">
            <form asp-action="Requests" method="get" class="row g-2 align-items-end" id="lab-requests-filter">
                <div class="col-md-3">
                    <label for="Status" class="form-label">Status</label>
                    <select name="Status" id="Status" class="form-select">
                        <option value="">All incoming</option>
                        @foreach (var status in LabRequestFilter.IncomingStatuses)
                        {
                            <option value="@status" selected="@(Model.Filter.Status == status)">@statusNames[status]</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="Date" class="form-label">Arrival Date</label>
                    <input type="date" name="Date" id="Date" class="form-control"
                           value="@Model.Filter.Date?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label for="PatientName" class="form-label">Patient Name</label>
                    <input type="text" name="PatientName" id="PatientName" class="form-control" maxlength="100"
                           value="@Model.Filter.PatientName" placeholder="Part of the name" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a asp-action="Requests" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Requests.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="lab-incoming-requests">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Tests</th>
                                <th>Arrived</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.Requests)
                            {
                                <tr>
                                    <td>@request.Id</td>
                                    <td>@request.Patient.User.FullName</td>
                                    <td>Dr. @request.Doctor.User.FullName</td>
                                    <td>@string.Join(", ", request.Items.Select(i => i.LabTest.Name).Order())</td>
                                    <td>@request.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><partial name="_LabRequestStatus" model="request.Status" /></td>
                                    <td>
                                        <a asp-action="RequestDetails" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-box-arrow-up-right"></i> Open
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h4 class="mt-3" id="lab-requests-empty">
                        @(Model.Filter.IsEmpty ? LabIncomingRequestsViewModel.NoRequestsMessage : LabIncomingRequestsViewModel.NoMatchMessage)
                    </h4>
                </div>
            }
        </div>
    </div>
</div>
