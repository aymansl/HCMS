@model HCMS4.Modules.Lab.Models.LabRequest
@using HCMS4.Modules.Lab.Models

@{
    ViewData["Title"] = $"Lab Request #{Model.Id}";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Lab Request #@Model.Id <partial name="_LabRequestStatus" model="Model.Status" /></h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active">Request #@Model.Id</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-person me-2"></i>Patient</h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8" id="request-patient">@Model.Patient.User.FullName</dd>
                        <dt class="col-sm-4">Date of Birth</dt>
                        <dd class="col-sm-8">@(Model.Patient.DateOfBirth?.ToString("yyyy-MM-dd") ?? "-")</dd>
                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@(Model.Patient.User.PhoneNumber ?? "-")</dd>
                        <dt class="col-sm-4">Doctor</dt>
                        <dd class="col-sm-8">Dr. @Model.Doctor.User.FullName</dd>
                        <dt class="col-sm-4">Requested</dt>
                        <dd class="col-sm-8">@Model.RequestedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                        @if (Model.ReceivedAt.HasValue)
                        {
                            <dt class="col-sm-4">Received</dt>
                            <dd class="col-sm-8" id="request-received-at">@Model.ReceivedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-list-check me-2"></i>Requested Tests</h5>
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr><th>Test</th><th>Unit</th><th>Reference Range</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items.OrderBy(i => i.LabTest.Name))
                            {
                                <tr><td><strong>@item.LabTest.Name</strong></td><td>@item.LabTest.Unit</td><td>@item.LabTest.ReferenceRange</td></tr>
                            }
                        </tbody>
                    </table>
                    <h6 class="text-muted">Clinical Notes</h6>
                    <p class="mb-0">@(Model.ClinicalNotes ?? "None")</p>
                    @if (Model.ReturnNote != null)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <strong>Returned to the doctor</strong> on @Model.ReturnedAt?.ToString("yyyy-MM-dd HH:mm"): @Model.ReturnNote
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.Status == LabRequestStatus.Requested)
    {
        <div class="card dashboard-card mt-3">
            <div class="card-body">
                <h5 class="card-title">Check the patient and the requested tests</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <form asp-action="ReceiveRequest" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check2-circle me-1"></i>Confirm Receipt
                            </button>
                        </form>
                    </div>
                    <div class="col-md-8">
                        <form asp-action="ReturnRequest" asp-route-id="@Model.Id" method="post">
                            <div class="input-group">
                                <input name="Note" class="form-control" maxlength="500" required
                                       placeholder="What is missing? (sent to the doctor)" />
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-arrow-return-left me-1"></i>Return to Doctor
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
