@model HCMS4.Modules.Lab.ViewModels.LabRequestFormViewModel

@{
    ViewData["Title"] = "Request Lab Test";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Request Lab Test</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="PatientRecord" asp-route-patientId="@Model.PatientId">Patient Record</a></li>
                    <li class="breadcrumb-item active">Request Lab Test</li>
                </ol>
            </nav>
        </div>
        <a asp-action="PatientRecord" asp-route-patientId="@Model.PatientId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Patient Record
        </a>
    </div>

    <div class="card dashboard-card">
        <div class="card-body">
            <form asp-action="CreateLabRequest" method="post">
                <partial name="_LabRequestForm" model="Model" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="PatientRecord" asp-route-patientId="@Model.PatientId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Send to Lab</button>
                </div>
            </form>
        </div>
    </div>
</div>
