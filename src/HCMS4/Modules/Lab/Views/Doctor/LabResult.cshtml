@model HCMS4.Modules.Lab.Models.LabRequest

@{
    ViewData["Title"] = $"Lab Result #{Model.Id}";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Lab Result #@Model.Id</h1>
            <p class="text-muted mb-0">@Model.Patient.User.FullName · requested @Model.RequestedAt.ToString("yyyy-MM-dd HH:mm")</p>
        </div>
        <a asp-action="LabRequests" asp-route-patientId="@Model.PatientId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Lab Requests
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert"><i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]</div>
    }

    @if (Model.HasCriticalResult)
    {
        if (Model.CriticalAcknowledgedAt.HasValue)
        {
            <div class="alert alert-secondary" id="critical-acknowledged">
                <i class="bi bi-check2-circle me-2"></i>Critical result acknowledged on @Model.CriticalAcknowledgedAt.Value.ToString("yyyy-MM-dd HH:mm").
            </div>
        }
        else
        {
            <div class="alert alert-danger d-flex justify-content-between align-items-center" id="critical-alert">
                <span><i class="bi bi-exclamation-octagon-fill me-2"></i><strong>Critical value.</strong> Review the result and confirm that you have seen it.</span>
                <form asp-action="AcknowledgeCriticalResult" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger"><i class="bi bi-check2 me-1"></i>Acknowledge</button>
                </form>
            </div>
        }
    }

    <div class="card dashboard-card">
        <div class="card-body">
            <partial name="~/Modules/Lab/Views/Lab/_LabResultTable.cshtml" model="Model" />
        </div>
    </div>
</div>
