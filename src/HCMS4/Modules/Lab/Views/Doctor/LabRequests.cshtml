@model HCMS4.Modules.Lab.ViewModels.DoctorLabRequestsViewModel
@using HCMS4.Modules.Lab.Models

@{
    ViewData["Title"] = "Lab Requests";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Lab Requests@(Model.PatientName != null ? $" — {Model.PatientName}" : "")</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                    @if (Model.PatientId.HasValue)
                    {
                        <li class="breadcrumb-item"><a asp-action="PatientRecord" asp-route-patientId="@Model.PatientId">Patient Record</a></li>
                    }
                    <li class="breadcrumb-item active">Lab Requests</li>
                </ol>
            </nav>
        </div>
        @if (Model.PatientId.HasValue)
        {
            <a asp-action="CreateLabRequest" asp-route-patientId="@Model.PatientId" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Request Lab Test
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Requests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="doctor-lab-requests">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Patient</th>
                                <th>Tests</th>
                                <th>Requested</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.Requests)
                            {
                                <tr>
                                    <td>@request.Id</td>
                                    <td>@request.Patient.User.FullName</td>
                                    <td>@string.Join(", ", request.Items.Select(i => i.LabTest.Name).Order())</td>
                                    <td>@request.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <partial name="~/Modules/Lab/Views/Lab/_LabRequestStatus.cshtml" model="request.Status" />
                                        @if (request.Status == LabRequestStatus.ReturnedToDoctor && request.ReturnNote != null)
                                        {
                                            <div class="text-danger small">@request.ReturnNote</div>
                                        }
                                        @if (request.Status == LabRequestStatus.Cancelled)
                                        {
                                            <div class="text-muted small">@request.CancelReason</div>
                                            @if (request.CancellationNote != null)
                                            {
                                                <div class="text-muted small">Lab: @request.CancellationNote</div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (request.Status == LabRequestStatus.ReturnedToDoctor)
                                        {
                                            <a asp-action="EditLabRequest" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Edit and Resend
                                            </a>
                                        }
                                        <a asp-action="LabRequestDetails" asp-route-id="@request.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-info-circle"></i> Details
                                        </a>
                                        @if (request.Status == LabRequestStatus.ResultIssued)
                                        {
                                            <a asp-action="LabResult" asp-route-id="@request.Id" class="btn btn-sm @(request.HasCriticalResult && request.CriticalAcknowledgedAt == null ? "btn-danger" : "btn-outline-success")">
                                                <i class="bi bi-clipboard-check"></i> View Result
                                            </a>
                                        }
                                        @if (request.Status is not (LabRequestStatus.Cancelled or LabRequestStatus.ResultIssued))
                                        {
                                            <a asp-action="CancelLabRequest" asp-route-id="@request.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle"></i> Cancel
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-eyedropper display-1 text-muted"></i>
                    <h4 class="mt-3">No Lab Requests</h4>
                    <p class="text-muted">No lab requests have been sent yet.</p>
                </div>
            }
        </div>
    </div>
</div>
