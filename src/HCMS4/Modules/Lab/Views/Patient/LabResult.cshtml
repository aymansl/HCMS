@model HCMS4.Modules.Lab.Models.LabRequest

@{
    ViewData["Title"] = "My Lab Result";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">My Lab Result</h1>
            <p class="text-muted mb-0">Requested by Dr. @Model.Doctor.User.FullName on @Model.RequestedAt.ToString("yyyy-MM-dd")</p>
        </div>
        <a asp-action="LabRequests" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to My Lab Tests
        </a>
    </div>

    <div class="card dashboard-card">
        <div class="card-body">
            <partial name="~/Modules/Lab/Views/Lab/_LabResultTable.cshtml" model="Model" />
            <p class="text-muted small mt-3 mb-0">Discuss your result with your doctor. Marked values are outside the usual range.</p>
        </div>
    </div>
</div>
