@model List<HCMS4.Modules.Lab.ViewModels.PatientLabRequestRow>

@{
    ViewData["Title"] = "My Lab Tests";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="mb-4">
        <h1 class="h3"><i class="bi bi-eyedropper me-2"></i>My Lab Tests</h1>
        <p class="text-muted mb-0">Book the time to give your sample. The lab collects samples Saturday to Thursday, 08:00–14:00.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-eyedropper display-1 text-muted"></i>
                    <h4 class="mt-3">No Lab Tests</h4>
                    <p class="text-muted">Your doctor has not requested any lab tests.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="patient-lab-requests">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Tests</th>
                                <th>Doctor</th>
                                <th>Status</th>
                                <th>Sample Collection</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                <tr>
                                    <td>@row.Request.Id</td>
                                    <td>@string.Join(", ", row.Request.Items.Select(i => i.LabTest.Name).Order())</td>
                                    <td>Dr. @row.Request.Doctor.User.FullName</td>
                                    <td><partial name="~/Modules/Lab/Views/Lab/_LabRequestStatus.cshtml" model="row.Request.Status" /></td>
                                    <td>
                                        @if (row.Appointment != null)
                                        {
                                            <strong>@row.Appointment.SlotStart.ToString("dddd yyyy-MM-dd HH:mm")</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not booked</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.CanBook)
                                        {
                                            <a asp-action="BookLabAppointment" asp-route-requestId="@row.Request.Id"
                                               class="btn btn-sm @(row.Appointment == null ? "btn-primary" : "btn-outline-primary")">
                                                <i class="bi bi-calendar-plus me-1"></i>@(row.Appointment == null ? "Book" : "Change")
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
