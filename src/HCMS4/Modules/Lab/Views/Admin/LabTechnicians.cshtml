@model IEnumerable<HCMS4.Modules.Lab.Models.LabTechnician>

@{
    ViewData["Title"] = "Lab Technicians";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Lab Technicians</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active">Lab Technicians</li>
                </ol>
            </nav>
        </div>
        <a asp-action="CreateLabTechnician" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Lab Technician
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Contact</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var technician in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@technician.FullName</strong>
                                        @if (!string.IsNullOrEmpty(technician.Qualifications))
                                        {
                                            <div class="text-muted small">@technician.Qualifications</div>
                                        }
                                    </td>
                                    <td>@technician.User?.Email</td>
                                    <td>@(technician.ContactInfo ?? "-")</td>
                                    <td>
                                        @if (technician.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Suspended</span>
                                            <div class="text-muted small">since @technician.DeactivatedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                                        }
                                    </td>
                                    <td>@technician.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (technician.IsActive)
                                        {
                                            <form asp-action="SuspendLabTechnician" asp-route-id="@technician.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Suspend this account? The technician will not be able to sign in.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-person-x"></i> Suspend
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ActivateLabTechnician" asp-route-id="@technician.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-person-check"></i> Reactivate
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-badge display-1 text-muted"></i>
                    <h4 class="mt-3">No Lab Technicians</h4>
                    <p class="text-muted">No lab technician accounts have been created yet.</p>
                    <a asp-action="CreateLabTechnician" class="btn btn-primary">Add the first lab technician</a>
                </div>
            }
        </div>
    </div>
</div>
