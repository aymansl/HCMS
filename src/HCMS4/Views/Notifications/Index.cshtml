@model List<HCMS4.Shared.Notifications.Models.UserNotification>

@{
    ViewData["Title"] = "Notifications";
    Layout = "_LayoutAuth";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3"><i class="bi bi-bell me-2"></i>Notifications</h1>
            <p class="text-muted mb-0">Your latest @HCMS4.Shared.Notifications.Controllers.NotificationsController.PageSize notifications, newest first.</p>
        </div>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-check2-all me-1"></i>Mark all as read
                </button>
            </form>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="list-group list-group-flush" id="notifications-list">
                    @foreach (var notification in Model)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-start @(notification.IsRead ? "" : "bg-light")">
                            <div class="me-3">
                                <div class="fw-semibold">
                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge bg-primary me-1">New</span>
                                    }
                                    @notification.Title
                                </div>
                                <div class="small text-muted">@notification.Message</div>
                                <div class="small text-muted">@notification.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                            <form asp-action="Open" asp-route-id="@notification.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">
                                    @(string.IsNullOrEmpty(notification.LinkUrl) ? "Mark as read" : "Open")
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-bell-slash display-1 text-muted"></i>
                    <h4 class="mt-3">No notifications</h4>
                </div>
            }
        </div>
    </div>
</div>
