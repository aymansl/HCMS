@model HCMS4.Models.Complaint

@{
    ViewData["Title"] = "Complaint Details";
    Layout = "_LayoutAuth";
}

<div class="container py-4">
    <div class="card dashboard-card">
        <div class="card-header">
            <h4 class="mb-0">Complaint @Model.TrackingNumber</h4>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <div class="mb-3"><strong>Patient:</strong> @Model.Patient?.User?.FullName</div>
            <div class="mb-3"><strong>Type:</strong> @Model.Type</div>
            <div class="mb-3"><strong>Title:</strong> @Model.Title</div>
            <div class="mb-3"><strong>Description:</strong> @Model.Description</div>
            @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
            {
                <div class="mb-3"><a asp-controller="ComplaintAttachments" asp-action="Download" asp-route-id="@Model.Id" target="_blank">View attachment</a></div>
            }

            <form asp-action="UpdateComplaintStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Status</label>
                    @* Bound to the current status so saving notes does not reset it to the first option. *@
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<HCMS4.Models.ComplaintStatus>()" class="form-select"></select>
                </div>
                <div class="mb-4">
                    <label class="form-label">Resolution Notes</label>
                    <textarea name="resolutionNotes" class="form-control" rows="4">@Model.ResolutionNotes</textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update Complaint</button>
                    <a asp-action="Complaints" class="btn btn-outline-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>
